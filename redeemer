            for _, qw in ipairs(qWords) do
                for _, kw in ipairs(kWords) do
                    if qw == kw then hits = hits + 1 end
                end
            end
            if hits >= 2 and hits > bestLen then
                bestKey = key
                bestLen = hits
            end
        end
    end
    if bestKey then return normalize(SAB_DB[bestKey]) end

    return nil
end

