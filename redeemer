local RIDDLE_KW = {
    "when was", "how old", "what year", "what month", "birthday", "age of",
    "released", "release date", "hint", "riddle", "figure out", "guess",
    "first letter", "combine", "spell", "backwards", "months", "years",
    "old is", "how many", "what is", "do you know", "can you", "which month",
    "which year", "how long", "since when", "created", "what day", "made on",
    "favorite", "favourite", "world cup", "mutation", "machine", "og",
}

local function isRiddle(txt)
    local l = txt:lower()
    for _, p in ipairs(RIDDLE_KW) do
        if l:find(p, 1, true) then return true end
    end
    if l:find("sammy") or l:find("spydersammy") or l:find("sab") then return true end
    return false
end

local function handleRiddle(message)
    if not _riddleSolver then return end
    setStatus("Riddle detected...", COLORS.Yellow)
    local ans = multiSolve(message)
    if ans then
        setStatus("Solved: " .. ans, COLORS.Green)
        rememberRiddle(message, ans)
        submitAnswer(ans)
        return
    end
    if not httpRequest then
        setStatus("No HTTP - riddle unsolved", COLORS.Red)
        return
    end
    setStatus("Asking AI...", COLORS.Yellow)
    task.spawn(function()
        local data = aiPost("/solve", {
            message = message,
            model   = AI_CONFIG.RaceModels and AI_CONFIG.BackupModel or AI_CONFIG.PrimaryModel,
            history = riddleHistory,
        })
        local top = (data and data.riddle == true and type(data.answers) == "table" and data.answers[1])
            and normalizeCode(data.answers[1]) or nil
        if top and #top > 0 then
            setStatus("AI solved: " .. top, COLORS.Green)
            rememberRiddle(message, top)
            submitAnswer(top)
            return
        end
        if AI_CONFIG.UserApiKey and AI_CONFIG.UserApiKey ~= "" then
            setStatus("Trying your AI key...", COLORS.Yellow)
            local custom = aiAskCustom(message, riddleHistory)
            if custom then
                setStatus("Custom AI solved: " .. custom, COLORS.Green)
                rememberRiddle(message, custom)
                submitAnswer(custom)
                return
            end
        end
        setStatus("Riddle unsolved", COLORS.Red)
    end)
end

