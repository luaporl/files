local function multiSolveInner(message)
    if type(message) ~= "string" then return nil end
    local raw = message:lower():gsub("<[^>]+>", "")
    raw = raw:gsub("[%?%!%.]+", " ")
    raw = raw:gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")

    do
        local WORDNUMS = { one = 1, two = 2, three = 3, four = 4, five = 5, six = 6, seven = 7, eight = 8, nine = 9, ten = 10, eleven = 11, twelve = 12, twenty = 20, thirty = 30 }
        local wa, wb = raw:match("(%S+)%s+plus%s+(%S+)")
        if not wa then wa, wb = raw:match("(%S+)%s*%+%s*(%S+)") end
        if wa and wb then
            local na, nb
            if wa:match("^%d+$") then na = tonumber(wa) else na = WORDNUMS[wa] end
            if wb:match("^%d+$") then nb = tonumber(wb) else nb = WORDNUMS[wb] end
            if na and nb then return tostring(na + nb) end
        end
    end

    local wholeBR = brainrotWhole(raw)
    if wholeBR then return wholeBR end

    local work = raw
        :gsub("%s+&%s+", " and ")
        :gsub("%s+plus%s+", " and ")
        :gsub("%s+then%s+", " and ")
        :gsub("%s+followed by%s+", " and ")
        :gsub("%s*,%s*", " and ")
        :gsub("%s+after it%s*", " ")
        :gsub("%s+after%s*$", " ")

    local chunks = {}
    local rest = work
    while true do
        local a, b = rest:match("^(.-)%s+and%s+(.+)$")
        if a then
            a = a:gsub("^%s+", ""):gsub("%s+$", "")
            if #a > 0 then chunks[#chunks + 1] = a end
            rest = b
        else
            rest = rest:gsub("^%s+", ""):gsub("%s+$", "")
            if #rest > 0 then chunks[#chunks + 1] = rest end
            break
        end
    end

    if #chunks <= 1 then
        local single = localSolve(message)
        local num = raw:match("(%d+)%s*$")
        if num and single and not tostring(single):find(num, 1, true) then
            local core = raw:gsub("%d+%s*$", "")
            local base = localSolve(core) or single
            if base then return base .. num end
        end
        if single then return single end
        return nil
    end

    local parts = {}
    for _, part in ipairs(chunks) do
        part = part:gsub("^%s+", ""):gsub("%s+$", "")
        local cleaned = part
            :gsub("^what is the ", ""):gsub("^what is ", "")
            :gsub("^whats the ", ""):gsub("^whats ", "")
            :gsub("^the ", ""):gsub("^a ", ""):gsub("^an ", "")
            :gsub("%s+after it%s*", ""):gsub("%s+after%s*$", "")
        local ans = nil
        if cleaned:match("^%d+$") then
            ans = cleaned
        else
            ans = solveOnePart(cleaned) or localSolve(cleaned) or localSolve(part)
            if not ans and cleaned:match("^[%w]+$") and #cleaned <= 12 then
                local hasLonger = false
                for key in pairs(SAB_BRAINROTS) do
                    local kk = cleanQuery(key)
                    if kk ~= cleaned and kk:find(cleaned, 1, true) then hasLonger = true break end
                end
                if not hasLonger then ans = cleaned:upper() end
            end
        end
        if ans and #tostring(ans) > 0 then
            parts[#parts + 1] = tostring(ans)
        end
    end

    if #parts >= 1 then
        return table.concat(parts, "")
    end
    return localSolve(message)
end

