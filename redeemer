-- ============================================================================
-- ANTI-LAG (frame-batched, no startup freeze)
-- ============================================================================
local function antiLagPart(obj)
    if not obj then return end
    pcall(function()
        if obj:IsA("BasePart") then
            obj.Material = Enum.Material.Plastic
            obj.Reflectance = 0
            obj.CastShadow = false
        elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") then
            obj.Enabled = false
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            obj.Transparency = 1
        end
    end)
end

local function applyAntiLag()
    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
        Lighting.Brightness = 1
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
    end)
    for _, child in ipairs(Lighting:GetChildren()) do
        pcall(function()
            if child:IsA("PostEffect") then child.Enabled = false end
        end)
    end

    antiLagHeartbeat = RunService.Heartbeat:Connect(function()
        for _ = 1, 12 do
            local obj = table.remove(antiLagQueue, 1)
            if not obj then break end
            antiLagPart(obj)
        end
    end)

    if not _antiLagConnection then
        _antiLagConnection = workspace.DescendantAdded:Connect(function(obj)
            antiLagQueue[#antiLagQueue + 1] = obj
        end)
    end
end
applyAntiLag()

