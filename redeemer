-- brainrot totals: 520 brainrots across 16 rarity tiers
local function normalize(s)
    if type(s) ~= "string" then return "" end
    return (s:upper():gsub("%s+", ""):gsub("[^%w]", ""))
end

local function cleanQuery(s)
    if type(s) ~= "string" then return "" end
    s = s:lower()
    s = s:gsub("<[^>]+>", "")
    s = s:gsub("[^%w%s]", " ")
    s = s:gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
    return s
end

local BRAINROT_PREFIXES = {
    "what is the", "what is a", "what is an", "what is", "whats the", "whats a", "whats an", "whats",
    "what are the", "what are", "what was the", "what was", "the", "a", "an",
}

-- Resolve a question about a brainrot/animal: returns (answer, matched key).
-- Wants rarity -> rarity tier. Otherwise returns the brainrot name itself.
local function brainrotAnswer(message)
    if type(message) ~= "string" then return nil end
    local raw = message:lower():gsub("<[^>]+>", "")
    local q = cleanQuery(message)
    if q == "" then q = raw end
    local wantsRarity = raw:find("rarity") ~= nil or raw:find("rarest") ~= nil and raw:find("brainrot") ~= nil
        or raw:find("how rare") ~= nil or raw:find("rarer") ~= nil
    local bestKey, bestLen = nil, 0
    for key, _ in pairs(SAB_BRAINROTS) do
        local k = cleanQuery(key)
        if #k >= 3 and not k:match("^%d+$") and #k > bestLen then
            if q:find(k, 1, true) or raw:find(k, 1, true) then
                bestKey, bestLen = key, #k
            end
        end
    end
    if not bestKey then return nil end
    if wantsRarity then
        local r = normalize(SAB_RARITY[bestKey] or "")
        if r ~= "" then return r, bestKey end
    end
    return normalize(bestKey), bestKey
end

