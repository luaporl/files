    if SAB_DB[stripped] then return normalize(SAB_DB[stripped]) end

    local brAns = brainrotAnswer(message)
    if brAns then return brAns end

    -- longest-key partial match (exclude generic game-name keys: exact match only)
    local bestKey, bestLen = nil, 0
    for key, ans in pairs(SAB_DB) do
        if #key >= 3 and #key > bestLen then
            if normalize(ans) ~= "STEALABRAINROT" then
                if q:find(key, 1, true) or stripped:find(key, 1, true) or raw:find(key, 1, true) then
                    bestKey = key
                    bestLen = #key
                end
            end
        end
    end
    if bestKey then return normalize(SAB_DB[bestKey]) end

    -- word overlap scoring (last resort)
    local function words(s)
        local t = {}
        for w in s:gmatch("%w+") do
            if #w > 2 then t[#t + 1] = w end
        end
        return t
    end
    local qWords = words(q)
