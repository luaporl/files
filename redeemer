local function resolveRedeemRemote()
    if RedeemRemote and RedeemRemote.Parent then return RedeemRemote end
    local ok, api = pcall(require, Net)
    if ok and type(api) == "table" then
        local rok, rf = pcall(function() return api:RemoteFunction(REDEEM_GUID) end)
        if rok and typeof(rf) == "Instance" then RedeemRemote = rf end
    end
    return RedeemRemote
end

local function redeemViaBox(code)
    if not getconns then return false, "no getconnections" end
    local box = nexusCodeBox()
    if not box then return false, "no codebox" end
    local ok, conns = pcall(getconns, box.FocusLost)
    if not ok or type(conns) ~= "table" or #conns == 0 then return false, "no connection" end
    local fired = false
    for _, c in ipairs(conns) do
        local fn
        pcall(function() fn = c.Function end)
        killDebounce(fn)
        box.Text = code
        box.Active = true
        box.Selectable = true
        local fok = pcall(function() if c.Enabled ~= false then c:Fire(true) end end)
        fired = fired or fok
    end
    return fired, fired and "sent via box" or "fire failed"
end

local function redeemViaRemote(code)
    local rf = resolveRedeemRemote()
    if not rf then return false, "no remote" end
    local ok, result = pcall(function() return rf:InvokeServer(code) end)
    if not ok then return false, tostring(result) end
    return true, result
end

local CachedRF = nil
local function redeemViaRF(code)
    if not CachedRF or not CachedRF.Parent then
        CachedRF = nil
        pcall(function()
            for _, rf in ipairs(ReplicatedStorage:GetDescendants()) do
                if rf:IsA("RemoteFunction") then
                    local n = rf.Name:lower()
                    if n:find("redeem") then
                        CachedRF = rf
                        return
                    end
                end
            end
        end)
    end
    if not CachedRF then return false end
    local rf = CachedRF
    task.spawn(function()
        local ok, result = pcall(function() return rf:InvokeServer(code) end)
        if ok then
            setStatus("RF redeemed: " .. code, COLORS.Green)
        else
            setStatus("RF invalid: " .. code .. " (" .. tostring(result) .. ")", COLORS.Red)
        end
    end)
    return true
end

local function redeemViaUISearch(code)
    local box = nexusCodeBox()
    if not box then return false, "no codebox visible" end

    pcall(function() box.Text = code end)

    local searchNames = { "submit", "redeem", "claim", "confirm", "enter", "send", "apply", "ok", "use", "go", "check" }
    local checked = {}

    local parents = { box.Parent, box.Parent and box.Parent.Parent }
    for i = 1, 2 do
        local parent = parents[i]
        if not parent then
            -- skip nil parent slot
        else
            for _, d in ipairs(parent:GetDescendants()) do
                if not checked[d] then
                    if (d:IsA("TextButton") or d:IsA("ImageButton")) and not isOurGui(d) and d ~= box then
                        checked[d] = true
                        local n = d.Name:lower()
                        local txt = ""
                        pcall(function() txt = d.Text:lower() end)
                        for _, sn in ipairs(searchNames) do
                            if n:find(sn) or txt:find(sn) then
                                if isVisibleChain(d) then clickButton(d); return true, "submitted via UI" end
                            end
                        end
                    end
                end
            end
        end
    end

    fireBoxFocusLost(box)
    return true, "submitted via focus lost"
end

local function nexusRedeem(code)
    if not code or code == "" then return false, "empty" end
    local ok, res = redeemViaBox(code)
    if ok then return true, res end
    ok, res = redeemViaRemote(code)
    if ok then return true, res end
    if redeemViaRF(code) then return true, "redeemed via RF" end
    return redeemViaUISearch(code)
end

