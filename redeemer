-- Answer "what is the (X) multiplier of <mutation>" style questions
local function mutationInfoAnswer(message)
    if type(message) ~= "string" then return nil end
    local raw = message:lower()
    local wantsMult = raw:find("multiplier") or raw:find("sell") or raw:find("price") or raw:find("value") or raw:find("worth") or raw:find("boost") or raw:find("rate")
    local wantsColor = raw:find("color") or raw:find("colour") or raw:find("shade")
    if not wantsMult and not wantsColor then return nil end
    local bestKey, bestLen = nil, 0
    for key, info in pairs(SAB_MUTATION_INFO) do
        if #key > bestLen and raw:find(key, 1, true) then
            bestKey, bestLen = key, #key
        end
    end
    if not bestKey then return nil end
    local info = SAB_MUTATION_INFO[bestKey]
    if wantsMult then return info.mult end
    return info.color
end

-- Returns the answer only when the whole message is ONE brainrot question
-- (handles names that contain " and " so multiSolve doesn't split them).
local function brainrotWhole(message)
    local ans, key = brainrotAnswer(message)
    if not ans or not key then return nil end
    local q = cleanQuery(message)
    local k = cleanQuery(key)
    local rest = q:gsub(k, "", 1):gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
    if rest == "" then return ans end
    for word in rest:gmatch("%w+") do
        if not BRAINROT_SCAFFOLD[word] then return nil end
    end
    return ans
end

