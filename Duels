_G.NexusPerfOptSaveSnapshot = function()
	_G.NexusPerfOptSaved = {
		NS = NS, CS = CS, LAGGER_SPEED = LAGGER_SPEED, LAGGER_CARRY_SPEED = LAGGER_CARRY_SPEED,
		autoStealRadius = autoStealRadius,
		fpsBoostEnabled = fpsBoostEnabled, antiLagVisualEnabled = antiLagVisualEnabled,
		nukeOptimiserEnabled = nukeOptimiserEnabled,
		fovEnabled = fovEnabled, fovValue = fovValue,
