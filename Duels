function _G.NexusPredictAimbotPosition(target, root)
local targetPos = target.Position
local targetVel = target.AssemblyLinearVelocity
local speed = targetVel.Magnitude
local dist = (targetPos - root.Position).Magnitude
local hist = _G.NexusNormalAimbot._velHistory
hist[target] = hist[target] or {}
local vh = hist[target]
table.insert(vh, targetVel)
if #vh > 6 then table.remove(vh, 1) end
local accel = Vector3.zero
if #vh >= 3 then
accel = (vh[#vh] - vh[#vh - 2]) * 30
end
local aceLead = math.clamp(speed / 125, 0.06, 0.18)
local distLead = math.clamp(dist / 350, 0, 0.1)
local predictTime = aceLead + distLead
local smoothedVel = targetVel
if #vh >= 2 then
smoothedVel = (vh[#vh] + vh[#vh - 1]) * 0.5
end
local predictedVel = smoothedVel + accel * predictTime * 0.35
local aimPos = targetPos + predictedVel * predictTime + Vector3.new(0, AIMBOT_V_OFF or 1.15, 0)
if speed > 8 then
aimPos = aimPos + smoothedVel.Unit * math.clamp(speed * 0.014, 0.25, 1.4)
end
return aimPos, smoothedVel, dist
end
