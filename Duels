				end
			end

			-- IMPORTANT: previews must NOT inherit the player's currently worn outfit.
			-- Keep only the base character body, then build the selected Nexus skin on top.
			-- This prevents the current avatar/clothes/accessories from appearing underneath
			-- the skin or making it look like there are two avatars.
			for _, child in ipairs(model:GetChildren()) do
				if child:IsA("Accessory") or child:IsA("Hat") or child:IsA("Tool")
					or child:IsA("Shirt") or child:IsA("Pants")
					or child:IsA("ShirtGraphic") then
					child:Destroy()
				end
			end

			-- Remove layered clothing/accessory remnants nested inside the model too.
			for _, desc in ipairs(model:GetDescendants()) do
				if desc:IsA("Accessory") or desc:IsA("Tool") then
					desc:Destroy()
				end
			end

			if packName ~= "Off" then
				local okApply, err = pcall(function()
					applyOutfitToPreview(model, packName)
				end)
				if not okApply then
					warn("[NexusSkinGallery] Preview apply failed: " .. tostring(err))
				end
			end

			for _, part in ipairs(model:GetDescendants()) do
				if part:IsA("BasePart") then
					part.Anchored = true
					part.CanCollide = false
					part.CanTouch = false
					part.CanQuery = false
					part.CastShadow = false
				end
			end

			model.Parent = world
			pcall(function()
				model:PivotTo(CFrame.new(0, 0, 0) * CFrame.Angles(0, math.rad(180), 0))
			end)

			-- Frame the BODY, not the accessories. Some Nexus accessories have large
			-- offsets/bounds; using model:GetBoundingBox() would make the whole skin
			-- suddenly tiny when the gallery is reopened after equipping it.
			local root = model:FindFirstChild("HumanoidRootPart")
			local torso = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso") or root
			local head = model:FindFirstChild("Head")
			local target
			if torso and torso:IsA("BasePart") then
				target = torso.Position + Vector3.new(0, 0.45, 0)
			elseif root and root:IsA("BasePart") then
				target = root.Position + Vector3.new(0, 1.0, 0)
			elseif head and head:IsA("BasePart") then
				target = head.Position + Vector3.new(0, -0.6, 0)
			else
				target = Vector3.new(0, 1, 0)
			end

			-- Fixed character-sized framing keeps every skin visually consistent.
			-- Accessories are still fully visible because the camera is aimed at the
			-- center of the body instead of calculating distance from their bounds.
			local distance = 6.65
			cam.FieldOfView = 30
			cam.CFrame = CFrame.lookAt(target + Vector3.new(0, 0.05, distance), target)
			cam.Focus = CFrame.new(target)
		end

		local function updateGridLayout()
			local cam = workspace.CurrentCamera
			local width = cam and cam.ViewportSize.X or 1000
			if width < 500 then
				gridLayout.CellSize = UDim2.fromOffset(130, 152)
				gridLayout.CellPadding = UDim2.fromOffset(6, 6)
