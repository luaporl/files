	if not char then return end
	for _, child in ipairs(char:GetChildren()) do
		if child ~= char and child:IsA("Model") then
			local extraHum = child:FindFirstChildOfClass("Humanoid")
			local looksDummy = extraHum or child.Name == "Dummy" or (child:FindFirstChild("HumanoidRootPart") and child:FindFirstChild("Head") and child:FindFirstChild("Torso"))
