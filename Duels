		["AV4"] = "Skin A4",
		["NX2"] = "Itachi Fit",
		["NX3"] = "Headless",
		["AV6"] = "Skin A6",
		["NX6"] = "Skin A1",
		["NX7"] = "Skin A2",
		["NX8"] = "Skin A3",
	}
	local galleryGui = nil

	local function applyOutfitToPreview(char, packName)
		-- Gallery preview uses the same skin-construction logic as the Skin Changer:
		-- BodyColors -> head mesh/texture -> existing Shirt/Pants -> Handle+Attachment welds.
		if not char or packName == "Off" then return end
		local config = NEXUS_BLEED_PACKS[packName]
		if not config then return end
		local head = char:FindFirstChild("Head")
		if not head then return end

		pcall(function()
			if config.skinColor then
				local bc = char:FindFirstChildWhichIsA("BodyColors") or Instance.new("BodyColors")
				bc.HeadColor3 = config.skinColor
				bc.TorsoColor3 = config.skinColor
				bc.LeftArmColor3 = config.skinColor
				bc.RightArmColor3 = config.skinColor
				bc.LeftLegColor3 = config.skinColor
				bc.RightLegColor3 = config.skinColor
				bc.Parent = char
			end
		end)

		pcall(function()
			if config.headMesh then
				if head:IsA("MeshPart") then
					head.MeshId = config.headMesh
					if config.headTexture then head.TextureID = config.headTexture end
				else
					local sm = head:FindFirstChildWhichIsA("SpecialMesh") or Instance.new("SpecialMesh")
					sm.Parent = head
					sm.MeshType = Enum.MeshType.FileMesh
					sm.MeshId = config.headMesh
					sm.TextureId = config.headTexture or ""
				end
			end
			if config.headTransparency ~= nil then head.Transparency = tonumber(config.headTransparency) or 0 end
			if config.skinColor and head:IsA("BasePart") then head.Color = config.skinColor end
		end)

		pcall(function()
			if config.shirt and config.shirt ~= "" then
				local shirt = char:FindFirstChildWhichIsA("Shirt") or Instance.new("Shirt")
				shirt.Name = "Shirt"
				shirt.ShirtTemplate = config.shirt
				shirt.Parent = char
			end
		end)
		pcall(function()
			if config.pants and config.pants ~= "" then
				local pants = char:FindFirstChildWhichIsA("Pants") or Instance.new("Pants")
				pants.Name = "Pants"
				pants.PantsTemplate = config.pants
				pants.Parent = char
			end
		end)

		local function findAtt(model, name)
			for _, p in ipairs(model:GetDescendants()) do
				if p:IsA("Attachment") and p.Name == name and p.Parent:IsA("BasePart") then
					return p
				end
			end
			return nil
		end

		local function loadPreviewHandle(assetId)
			local objs
			local ok, res = pcall(function()
				return game:GetObjects("rbxassetid://" .. tostring(assetId))
			end)
			if ok and type(res) == "table" and #res > 0 then
				objs = res
			else
				ok, res = pcall(function()
					return game:GetService("InsertService"):LoadAsset(assetId)
				end)
				if ok and res then objs = {res} end
			end
			if not objs then return nil end
			local handle
			for _, o in ipairs(objs) do
				if o:IsA("BasePart") and o.Name == "Handle" then handle = o; break end
			end
			if not handle then
				for _, o in ipairs(objs) do
					if o:IsA("BasePart") then handle = o; break end
					local h = o:FindFirstChildWhichIsA("BasePart", true)
					if h then handle = h; break end
				end
			end
			local clone = handle and handle:Clone() or nil
			for _, o in ipairs(objs) do pcall(function() o:Destroy() end) end
			return clone
		end

		local function equipPreviewItem(assetId, fallbackOffset, name)
			if not assetId then return false end
			local H = loadPreviewHandle(assetId)
			if not H then return false end
			H.Name = name or ("NexusPreviewAcc_" .. tostring(assetId))
			H.CanCollide = false
			H.Anchored = false
			H.Massless = true

			local hAtt = H:FindFirstChildOfClass("Attachment")
			local bAtt = hAtt and findAtt(char, hAtt.Name)
			local target = (bAtt and bAtt.Parent) or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("Head")
			if not target then H:Destroy(); return false end

			local c0 = bAtt and bAtt.CFrame or CFrame.new(fallbackOffset or Vector3.new(0, 1.4, 0))
			local c1 = hAtt and hAtt.CFrame or CFrame.new()
			H.CFrame = target.CFrame * c0 * c1:Inverse()
			H.Parent = char

			local w = Instance.new("Weld")
			w.Part0 = target
			w.Part1 = H
			w.C0 = c0
			w.C1 = c1
			w.Parent = H
			return true
		end

		if type(config.accessories) == "table" then
			for i, id in ipairs(config.accessories) do
				equipPreviewItem(id, config.offset, "NexusPreviewAcc_" .. tostring(i))
			end
		elseif config.accessory then
			equipPreviewItem(config.accessory, config.offset, "NexusPreviewAcc")
		end
		if config.hair then
			equipPreviewItem(config.hair, Vector3.new(0, head.Size.Y * 0.5 + 0.15, 0), "NexusPreviewHair")
		end

		if config.korblox and config.korblox ~= "none" then
			pcall(function()
				local ids = {left = 139607673, right = 139607718}
				local targets = {left = "LeftUpperLeg", right = "RightUpperLeg"}
				local hides = {left = {"LeftUpperLeg","LeftLowerLeg","LeftFoot"}, right = {"RightUpperLeg","RightLowerLeg","RightFoot"}}
				local side = config.korblox
				local targetPart = char:FindFirstChild(targets[side])
				if not targetPart then return end
				for _, pn in ipairs(hides[side]) do
					local limb = char:FindFirstChild(pn)
					if limb and limb:IsA("BasePart") then limb.Transparency = 1 end
				end
				local mesh = loadPreviewHandle(ids[side])
				if mesh then
					mesh.Name = "NexusPreviewKorblox"
					mesh.Anchored = true
					mesh.CanCollide = false
					mesh.Massless = true
					mesh.CFrame = targetPart.CFrame
					mesh.Parent = char
				end
			end)
		end
	end

	-- Preview prototypes are built (and their assets preloaded) as soon as the
	-- script executes, so opening the gallery instantly shows finished previews
	-- instead of half-loaded ones. Joints are reset so every preview shows the
	-- standing idle pose, exactly like the Skin Changer source preview.
	local previewPrototypes = {}

	local function buildPreviewPrototype(packName)
		local source = LP.Character
		if not source then return nil end
		local oldArch = source.Archivable
		local ok, clone = pcall(function()
			source.Archivable = true
			local c = source:Clone()
			source.Archivable = oldArch
			return c
		end)
		pcall(function() if oldArch ~= nil then source.Archivable = oldArch end end)
		if not ok or not clone then return nil end

		clone.Name = "NexusPreviewProto_" .. tostring(packName)

		-- Match the Skin Changer preview cleanup: remove executable content and
		-- existing Roblox accessories, but keep the character's body/clothing
		-- structure so the skin is applied onto the same kind of clone.
		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("ModuleScript")
				or d:IsA("Tool") or d:IsA("Accessory") or d:IsA("Hat") then
				pcall(function() d:Destroy() end)
			end
		end
		for _, d in ipairs(clone:GetChildren()) do
			local n = tostring(d.Name)
			if n == "NexusPackAcc" or n:sub(1, 13) == "NexusPackAcc_"
				or n:sub(1, 16) == "NexusPreviewAcc" or n == "NexusPreviewHair"
				or n == "NexusPreviewKorblox" or n == "NexusGallery_Hair"
				or n:sub(1, 4) == "FX3_" or n == "FX3_AvatarBlackout" then
				pcall(function() d:Destroy() end)
			end
		end

		local hum = clone:FindFirstChildOfClass("Humanoid")
		if hum then
			pcall(function()
				hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
				hum.AutoRotate = false
			end)
		end

		if packName and packName ~= "Off" then
			pcall(function() applyOutfitToPreview(clone, packName) end)
		end

		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide = false
				d.CanTouch = false
				d.CanQuery = false
				d.CastShadow = false
			end
		end

		return clone
	end

	-- Build every pack preview right away at execute time and warm the asset
	-- cache, so the gallery never shows unfinished previews.
	task.spawn(function()
		if not LP.Character then
			pcall(function() LP.CharacterAdded:Wait() end)
			task.wait(0.5)
		end
		local okCP, ContentProvider = pcall(function() return game:GetService("ContentProvider") end)
		for _, entry in ipairs(ACCESSORY_PACK_ORDER) do
			local packName = entry[2]
			local proto = buildPreviewPrototype(packName)
