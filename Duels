			end)
			if not ok or typeof(objects) ~= "table" or #objects == 0 then return end

			local sourceHandle
			for _, obj in ipairs(objects) do
				if obj:IsA("BasePart") then
					sourceHandle = obj
					break
				end
				local nested = obj:FindFirstChildWhichIsA("BasePart", true)
				if nested then
