		local function makePreview(vp, packName)
			clearPreviewViewport(vp)

			-- EXACT Skin Changer ViewportFrame setup
			vp.Ambient = Color3.fromRGB(175, 175, 185)
			vp.LightColor = Color3.fromRGB(255, 255, 255)
			vp.LightDirection = Vector3.new(-0.5, -1, -0.4)
