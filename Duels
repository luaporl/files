_antiDropMt = mt
_antiDropOldIdx = mt.__index
_antiDropOldNewIdx = mt.__newindex
pcall(function() setreadonly(mt, false) end)
local hookedOk = pcall(function()
mt.__index = newcclosure(function(self, key)
if not checkcaller() and _antiDropIsLocalHrp(self, key) then return _antiDropSpoofVel end
return _antiDropOldIdx(self, key)
end)
mt.__newindex = newcclosure(function(self, key, value)
if not checkcaller() and _antiDropIsLocalHrp(self, key) then
_antiDropSpoofVel = value
return
end
return _antiDropOldNewIdx(self, key, value)
end)
end)
pcall(function() setreadonly(mt, true) end)
if not hookedOk then
pcall(function()
if _antiDropOldIdx then mt.__index = _antiDropOldIdx end
if _antiDropOldNewIdx then mt.__newindex = _antiDropOldNewIdx end
end)
_antiDropMt, _antiDropOldIdx, _antiDropOldNewIdx = nil, nil, nil
