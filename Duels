local function nexusRestoreOriginalAccessories(char)
	if not char then return end
	for _, child in ipairs(char:GetChildren()) do
		if child:IsA("Accessory") or child:IsA("Hat") or child.Name == "NexusPackAcc" or string.sub(child.Name, 1, 13) == "NexusPackAcc_" then
			child:Destroy()
		end
	end
	for _, clone in ipairs(_G.NexusOriginalAccessories) do
		if clone and clone.Parent == nil then
			local newAcc = clone:Clone()
			newAcc.Parent = char
			for _, weld in ipairs(newAcc:GetDescendants()) do
				if weld:IsA("Weld") or weld:IsA("WeldConstraint") then
					local p0Name = weld.Part0 and weld.Part0.Name
					local p1Name = weld.Part1 and weld.Part1.Name
					if p0Name then local p0 = char:FindFirstChild(p0Name); if p0 then weld.Part0 = p0 end end
					if p1Name then local p1 = char:FindFirstChild(p1Name); if p1 then weld.Part1 = p1 end end
				end
			end
		end
	end
	_G.NexusOriginalAccessories = {}
end

