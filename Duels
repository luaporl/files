			end
		end)

		local function selectCard(packName)
			selectedPack = packName
			refreshSelection()
		end

		local function buildCard(packName, displayName, order)
			local card = Instance.new("TextButton")
			card.Name = "Card_" .. packName
			card.BackgroundColor3 = Color3.fromRGB(22, 22, 24)
			card.BackgroundTransparency = 0
			card.BorderSizePixel = 0
