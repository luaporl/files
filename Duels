local function applyCustomClothing(char)
	char = char or LP.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	local shirtKey = customShirt or "None"
	local pantsKey = customPants or "None"
	local shirtId = (shirtKey ~= "None") and SHIRT_IDS[shirtKey] or nil
	local pantsId = (pantsKey ~= "None") and PANTS_IDS[pantsKey] or nil
	pcall(function()
		local desc = hum:GetAppliedDescription()
		if shirtId then desc.Shirt = shirtId end
		if pantsId then desc.Pants = pantsId end
		hum:ApplyDescription(desc)
	end)
	local function applyTemplate(className, prop, id)
		if not id then return end
		local inst = char:FindFirstChildOfClass(className)
		if not inst then
			inst = Instance.new(className)
			inst.Name = className
			inst.Parent = char
		end
		pcall(function() inst[prop] = "rbxassetid://" .. tostring(id) end)
		pcall(function()
			if not inst[prop] or inst[prop] == "" or inst[prop] == "rbxassetid://0" then
				inst[prop] = "http://www.roblox.com/asset/?id=" .. tostring(id)
			end
		end)
		task.spawn(function()
			local loaded = nil
			pcall(function()
				if typeof(game.GetObjects) == "function" then
					local objs = game:GetObjects("rbxassetid://" .. tostring(id))
					loaded = objs and objs[1]
				end
			end)
			if not loaded then
				pcall(function() loaded = game:GetService("InsertService"):LoadAsset(id) end)
			end
			if loaded then
				local src = loaded:FindFirstChildOfClass(className) or (loaded:IsA(className) and loaded)
				if src and src[prop] and src[prop] ~= "" then
					pcall(function()
						local i = char:FindFirstChildOfClass(className) or Instance.new(className)
						i.Name = className
						i[prop] = src[prop]
						i.Parent = char
					end)
				end
				pcall(function() loaded:Destroy() end)
			end
		end)
	end
	applyTemplate("Shirt", "ShirtTemplate", shirtId)
	applyTemplate("Pants", "PantsTemplate", pantsId)
end
