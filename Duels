	local function getAsset(song)
		if not song then return nil end
		local okFile = false
		pcall(function() if isfile and isfile(song.file) then okFile = true end end)
		if not okFile and song.url then
			pcall(function()
				local data = game:HttpGet(song.url)
				if writefile and type(data) == "string" and #data > 1000 then
					writefile(song.file, data)
					okFile = true
				end
			end)
		end
		local getCustomAsset = getcustomasset or getsynasset
		if getCustomAsset then
			local ok, asset = pcall(function() return getCustomAsset(song.file) end)
			if ok and type(asset) == "string" then return asset end
		end
		return nil
	end

	local function playIndex(idx, keepState, resumeAt)
		if #songs < 1 then return end
		if idx < 1 then idx = #songs end
		if idx > #songs then idx = 1 end
		-- Resume same song in place: keep TimePosition, no reload/restart
		if resumeAt ~= nil and keepState ~= false and idx == songIdx
			and type(sound.SoundId) == "string" and sound.SoundId ~= "" then
			local ok = pcall(function()
				sound.TimePosition = resumeAt
				sound:Play()
			end)
			if ok then
				_G.NexusMusicPausedPos = nil
				playing = true
				lastMusicIndex = songIdx
				lastMusicFile = songs[songIdx].file or ""
				pcall(saveNexusConfig)
				paint()
				return
			end
		end
		_G.NexusMusicPausedPos = nil
		switching = true
		loadToken = loadToken + 1
		local myToken = loadToken
		pcall(function() sound:Stop() end)
		pcall(function() sound.TimePosition = 0 end)
		if _G.NexusAutoMusicSound then
			pcall(function() _G.NexusAutoMusicSound:Stop(); _G.NexusAutoMusicSound:Destroy() end)
			_G.NexusAutoMusicSound = nil
		end
		songIdx = idx
		local song = songs[songIdx]
		playing = (keepState ~= false)
		paint()
		task.spawn(function()
			local asset = getAsset(song)
			if myToken ~= loadToken then switching = false return end
			if not asset then
				playing = false
				switching = false
				paint()
				return
			end
			pcall(function() sound:Stop() end)
			sound.SoundId = asset
			sound.Looped = looped
			sound.Volume = volume
			local spd = tonumber(musicSpeed) or 1
			sound.PlaybackSpeed = math.clamp(spd, 0.5, 2)
			local t0 = tick()
			while myToken == loadToken and not sound.IsLoaded and (tick() - t0) < 8 do
				task.wait(0.05)
			end
			if myToken ~= loadToken then switching = false return end
			if keepState ~= false then
				local ok = pcall(function()
					sound.TimePosition = 0
					sound:Play()
				end)
				playing = ok and true or false
			else
				playing = false
			end
			switching = false
			lastMusicIndex = songIdx
			lastMusicFile = song.file or ""
			pcall(saveNexusConfig)
			paint()
		end)
	end

	local function stopAll()
		switching = true
		loadToken = loadToken + 1
		pcall(function() sound:Stop() end)
		pcall(function() sound.TimePosition = 0 end)
		_G.NexusMusicPausedPos = nil
		playing = false
		switching = false
		paint()
	end

	-- PAUSE: keep TimePosition so PLAY resumes where it stopped
	local function pauseAll()
		switching = true
		loadToken = loadToken + 1
		local ok, pos = pcall(function() return sound.TimePosition end)
		pcall(function() sound.Playing = false end)
		if ok and type(pos) == "number" and pos == pos and pos > 0 then
			pcall(function() sound.TimePosition = pos end)
			_G.NexusMusicPausedPos = pos
		else
			_G.NexusMusicPausedPos = nil
		end
		playing = false
		switching = false
		paint()
	end

	_G.NexusMusicPlayAt = function(idx)
		playIndex(tonumber(idx) or 1, true)
	end

	-- Disconnect previous Ended if any
	if _G.NexusMusicEndedConn then
		pcall(function() _G.NexusMusicEndedConn:Disconnect() end)
		_G.NexusMusicEndedConn = nil
	end
	_G.NexusMusicEndedConn = sound.Ended:Connect(function()
		if switching or not playing then return end
		if looped then
			pcall(function() sound.TimePosition = 0; sound:Play() end)
			return
		end
		playIndex(songIdx + 1)
	end)

	btnPlay.MouseButton1Click:Connect(function()
		if playing then
			pauseAll()
