-- Exact Kyz drivePathVelocity: AssemblyLinearVelocity + Move + WalkSpeed + move proxy
local function _nexusDrivePathVelocity(hrp, hum, mv, spd)
	local vy = hrp.AssemblyLinearVelocity.Y
	local vel = Vector3.new(mv.X * spd, vy, mv.Z * spd)
	hrp.AssemblyLinearVelocity = vel
	local proxy = _nexusEnsureMoveProxy()
	if proxy then
		proxy.AssemblyLinearVelocity = vel
	end
	pcall(function()
		hum.WalkSpeed = spd
		hum:Move(mv, false)
	end)
end

