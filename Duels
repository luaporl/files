		if absSize.X <= 0 then return end
		local ratio = math.clamp((x - absPos.X) / absSize.X, 0, 1)
		if sound.TimeLength and sound.TimeLength > 0 then
			pcall(function() sound.TimePosition = sound.TimeLength * ratio end)
		end
	end
