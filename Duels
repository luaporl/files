-- >>> BRAINROT TRANSPARENCY BEGIN
(function()
-- Same idea as Ambitious "Brainrot X-Ray":
-- brainrot models are identified from ReplicatedStorage.Datas.Animals,
-- then only their visible parts/decals/textures are made semi-transparent.
-- Original transparency is saved and restored exactly when disabled.
_G._NexusBrainrotTransparency = _G._NexusBrainrotTransparency or {
	enabled = false,
	trans = 0.5,
	names = nil,
	saved = {},
	conns = {},
	scanId = 0,
}

_G._NexusBrainrotTransparency.loadNames = function()
	local BR = _G._NexusBrainrotTransparency
	if BR.names then return BR.names end
	local t = {}
	pcall(function()
		local datas = ReplicatedStorage:FindFirstChild("Datas")
		local animals = datas and datas:FindFirstChild("Animals")
		if animals and animals:IsA("ModuleScript") then
			for k in pairs(require(animals)) do
				t[k] = true
			end
		end
	end)
	BR.names = t
	return t
end

_G._NexusBrainrotTransparency.isHitbox = function(o)
	local n = string.lower(o.Name)
	return (string.find(n, "hit") or string.find(n, "target") or string.find(n, "box")
		or string.find(n, "root") or string.find(n, "collect") or string.find(n, "prompt")) ~= nil
end

_G._NexusBrainrotTransparency.applyOne = function(o)
	local BR = _G._NexusBrainrotTransparency
	if not (o:IsA("BasePart") or o:IsA("Decal") or o:IsA("Texture")) then return end

	local orig = BR.saved[o]
	if orig == nil then
		orig = o.Transparency
		-- Treat already semi-transparent hitboxes as invisible, matching Ambitious.
		if orig > 0.5 and orig < 0.99 and o:IsA("BasePart") and BR.isHitbox(o) then
			orig = 1
		end
		BR.saved[o] = orig
	end

	if orig < 0.5 and o.Transparency ~= BR.trans then
		o.Transparency = BR.trans
	end
end

_G._NexusBrainrotTransparency.applyModel = function(m)
	local BR = _G._NexusBrainrotTransparency
	for _, o in ipairs(m:GetDescendants()) do
		BR.applyOne(o)
	end
end

_G._NexusBrainrotTransparency.isAnimal = function(m)
	local BR = _G._NexusBrainrotTransparency
	return m:IsA("Model") and BR.names and BR.names[m.Name] == true
end

_G._NexusBrainrotTransparency.animalAncestor = function(inst)
	local BR = _G._NexusBrainrotTransparency
	local p = inst.Parent
	for _ = 1, 5 do
		if not p or p == workspace then return nil end
		if p:IsA("Model") and BR.names and BR.names[p.Name] then
			return p
		end
		p = p.Parent
	end
	return nil
end

_G._NexusBrainrotTransparency.restoreAll = function()
	local BR = _G._NexusBrainrotTransparency
	local snapshot = BR.saved
	BR.saved = {}
	for o, orig in pairs(snapshot) do
		pcall(function()
			if o and o.Parent then
				o.Transparency = orig
			end
		end)
	end
end

_G.NexusSetBrainrotTransparency = function(on)
	local BR = _G._NexusBrainrotTransparency
	on = on and true or false
	BR.enabled = on
	_G.NexusBrainrotTransparencyEnabled = on

	for _, c in ipairs(BR.conns) do
		pcall(function() c:Disconnect() end)
	end
	BR.conns = {}
	BR.scanId = BR.scanId + 1

	if not on then
		BR.restoreAll()
		saveNexusConfig()
		return
	end

	BR.loadNames()
	local myScan = BR.scanId

	-- Initial scan is split into chunks so enabling it does not freeze the UI.
	task.spawn(function()
		local n = 0
		for _, d in ipairs(workspace:GetDescendants()) do
			if BR.scanId ~= myScan then return end
			if BR.isAnimal(d) then
				BR.applyModel(d)
			end
			n = n + 1
			if n % 500 == 0 then task.wait() end
		end
	end)

	-- New brainrots/parts are handled as they appear; no constant full rescan.
	table.insert(BR.conns, workspace.DescendantAdded:Connect(function(inst)
		if not BR.enabled then return end

		if inst:IsA("Model") then
			if BR.names and BR.names[inst.Name] then
				task.defer(function()
					if BR.enabled and inst.Parent then
						BR.applyModel(inst)
					end
				end)
			end
			return
		end

		if inst:IsA("BasePart") or inst:IsA("Decal") or inst:IsA("Texture") then
			if BR.animalAncestor(inst) then
				BR.applyOne(inst)
			end
		end
	end))

	saveNexusConfig()
end

_G.NexusBrainrotTransparencyRestore = function()
	if _G.NexusSetBrainrotTransparency then
		_G.NexusSetBrainrotTransparency(false)
	end
end

-- <<< BRAINROT TRANSPARENCY END
end)();

