-- ============================================================
-- ANTI ANTI DESYNC (Freeze Pulse) — LARP style
-- Only active when holding "Brainrot" tool
-- Enemy enters 10 radius → freeze 0.5s → stop
-- Enemy leaves 10 radius → reset, ready to pulse again
-- ============================================================
_G.NexusAntiAntiDesyncEnabled = _G.NexusAntiAntiDesyncEnabled == true
_G._aadConn = nil
_G._aadRestored = {}

local function _aadHold()
    local c = LP.Character
    if not c then return false end
    return c:FindFirstChild("Brainrot") and true or false
end

local function _aadFreeze(plr)
    local ch = plr.Character
    if not ch then return end
    local h = ch:FindFirstChildWhichIsA("Humanoid")
    if h then h.WalkSpeed = 0; h.JumpPower = 0; h.AutoRotate = false end
    for _, p in ipairs(ch:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = false end
    end
    _G._aadRestored[plr] = false
end

local function _aadUnfreeze(plr)
    if _G._aadRestored[plr] == false then
        local ch = plr.Character
        if ch then
            local h = ch:FindFirstChildWhichIsA("Humanoid")
            if h then h.WalkSpeed = 16; h.JumpPower = 50; h.AutoRotate = true end
        end
        _G._aadRestored[plr] = true
    end
end

local function _aadUnfreezeAll()
    for p, _ in pairs(_G._aadRestored) do _aadUnfreeze(p) end
    _G._aadRestored = {}
end

function _G.NexusToggleAntiAntiDesync(enabled)
    if enabled == nil then enabled = not _G.NexusAntiAntiDesyncEnabled end
    _G.NexusAntiAntiDesyncEnabled = enabled
    if _G._aadConn then _G._aadConn:Disconnect(); _G._aadConn = nil end
    _aadUnfreezeAll()
    if not enabled then return end
    local freezeActive = false
    local freezeEnd = 0
    local enemyNear = false
    _G._aadConn = RunService.Stepped:Connect(function()
        if not _G.NexusAntiAntiDesyncEnabled then return end
        if not _aadHold() then
            if freezeActive then _aadUnfreezeAll(); freezeActive = false end
            enemyNear = false
            return
        end
        local mc = LP.Character
        local mr = mc and mc:FindFirstChild("HumanoidRootPart")
        if not mr then return end
        local ce, cd = nil, math.huge
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl ~= LP and pl.Character then
                local tr = pl.Character:FindFirstChild("HumanoidRootPart")
                local th = pl.Character:FindFirstChildOfClass("Humanoid")
                if tr and th and th.Health > 0 then
                    local d = (mr.Position - tr.Position).Magnitude
                    if d < cd then cd = d; ce = pl end
                end
            end
        end
        local now = tick()
        if ce and cd <= 10 then
            if not enemyNear then
                enemyNear = true
                freezeActive = true
                freezeEnd = now + 0.5
                _aadUnfreezeAll()
            end
            if freezeActive and now <= freezeEnd then
                _aadFreeze(ce)
            elseif freezeActive and now > freezeEnd then
                freezeActive = false
                _aadUnfreezeAll()
            end
        else
            if enemyNear or freezeActive then
                enemyNear = false
                freezeActive = false
                _aadUnfreezeAll()
            end
        end
    end)
end

function _G.NexusStartAntiAntiDesync()
    _G.NexusToggleAntiAntiDesync(true)
