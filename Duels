local function startAutoDodge()
if autoDodgeOnSteal then autoDodgeSuspended = false end
autoDodgeEnabled = true
_clearAutoDodgeConnection()
autoDodgeLastRun = 0
autoDodgeConn = RunService.Heartbeat:Connect(function()
if not autoDodgeEnabled then _clearAutoDodgeConnection() return end
local now = tick()
local stealMode = autoDodgeOnSteal == true
local holding = false
if stealMode then
holding = type(_G.NexusSafeModeHoldingBrainrot) == "function" and _G.NexusSafeModeHoldingBrainrot()
if autoDodgeSuspended and not holding then autoDodgeSuspended = false end
end
if now - autoDodgeLastRun < 0.05 then return end
autoDodgeLastRun = now
pcall(function()
if stealMode then
if autoDodgeSuspended then return end
if not holding then return end
end
doAutoDodgeStep()
end)
end)
if setAutoDodgeVisual then setAutoDodgeVisual(true) end
end
local function stopAutoDodge()
if autoDodgeOnSteal then
autoDodgeSuspended = true
