			vp.Size = UDim2.new(1, -10, 1, -43)
			vp.Position = UDim2.fromOffset(5, 5)
			vp.BackgroundColor3 = Color3.fromRGB(11, 11, 13)
			vp.BackgroundTransparency = 0
			vp.BorderSizePixel = 0
			vp.Ambient = Color3.fromRGB(170, 170, 170)
			vp.LightColor = Color3.fromRGB(255, 255, 255)
			vp.ZIndex = 5
			vp.Parent = card
			corner(vp, 8)

			makePreview(vp, packName)

			local label = Instance.new("TextLabel")
			label.Name = "Name"
			label.Size = UDim2.new(1, -14, 0, 28)
			label.Position = UDim2.new(0, 7, 1, -32)
			label.BackgroundTransparency = 1
			label.Text = string.upper(displayName)
			label.TextColor3 = Color3.fromRGB(185, 185, 192)
			label.TextSize = 11
			label.Font = Enum.Font.GothamBold
			label.TextTruncate = Enum.TextTruncate.AtEnd
			label.TextXAlignment = Enum.TextXAlignment.Center
			label.ZIndex = 6
			label.Parent = card

			card.Activated:Connect(function()
				selectCard(packName)
			end)
		end

		for i, entry in ipairs(ACCESSORY_PACK_ORDER) do
			buildCard(entry[2], entry[1], i)
		end
		refreshSelection()

		local function closeGallery()
			if galleryClosing then return end
			galleryClosing = true
			if viewportConn then pcall(function() viewportConn:Disconnect() end) end

			if accSelectorLabel then
				accSelectorLabel.Text = tostring(currentAccessoryPack or "Off")
			end

			local info = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			local outPanel = TweenService:Create(panelScale, info, {Scale = panelScale.Scale * 0.94})
			local outOverlay = TweenService:Create(overlay, info, {BackgroundTransparency = 1})
			outPanel:Play()
			outOverlay:Play()
			outPanel.Completed:Wait()

			screen:Destroy()
			galleryGui = nil
			galleryClosing = false
		end

		overlay.Activated:Connect(closeGallery)
		closeBtn.Activated:Connect(closeGallery)

		applyBtn.Activated:Connect(function()
			currentAccessoryPack = selectedPack or "Off"
			if currentAccessoryPack ~= "Off" and _G.NexusApplyAccessoryPack then
				pcall(function() _G.NexusApplyAccessoryPack(currentAccessoryPack) end)
			end
			if currentAccessoryPack == "Off" then
				pcall(function()
					local char = LP.Character
					if char then
						nexusRestoreOriginalOutfit(char)
						nexusRestoreOriginalAccessories(char)
					end
				end)
			end
			pcall(saveNexusConfig)
			closeGallery()
		end)

		-- Opening animation.
		panelScale.Scale = panelScale.Scale * 0.94
		overlay.BackgroundTransparency = 1
		local info = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		TweenService:Create(panelScale, info, {Scale = panelScale.Scale / 0.94}):Play()
		TweenService:Create(overlay, info, {BackgroundTransparency = 0.38}):Play()

		galleryGui = screen
	end

	openBtn.MouseButton1Click:Connect(openGallery)
end
