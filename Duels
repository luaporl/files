_G.__NexusSetupSemiV2AutoSteal = function()
  _G.NexusSemiV2Steal = _G.NexusSemiV2Steal or {}
  local B = _G.NexusSemiV2Steal
  if B.conn then pcall(function() task.cancel(B.conn) end); B.conn = nil end
  B.enabled = false
  B.semiRadius = tonumber(_G.NexusStealRadii and _G.NexusStealRadii.SemiV2SemiRadius) or 8
  B.entryDelay = tonumber(_G.NexusSemiV2EntryDelay) or 0.3
  B.internalCache = B.internalCache or {}
  local function rootPart()
    local char = LP.Character
    return char and char:FindFirstChild("HumanoidRootPart")
  end
  local function isMyPlotByName(plotName)
    local plots = Workspace:FindFirstChild("Plots")
    local plot = plots and plots:FindFirstChild(plotName)
    local sign = plot and plot:FindFirstChild("PlotSign")
    if sign then
      local yb = sign:FindFirstChild("YourBase")
      if yb and yb:IsA("BillboardGui") then return yb.Enabled == true end
    end
    return false
  end
  local function findNearestInSemi()
    local root = rootPart()
    if not root then return nil end
    local plots = Workspace:FindFirstChild("Plots")
    if not plots then return nil end
    local nearest, nd = nil, math.huge
    for _, plot in ipairs(plots:GetChildren()) do
      if isMyPlotByName(plot.Name) then continue end
      local pods = plot:FindFirstChild("AnimalPodiums")
      if not pods then continue end
      for _, pod in ipairs(pods:GetChildren()) do
        pcall(function()
          local base = pod:FindFirstChild("Base")
          local spawn = base and base:FindFirstChild("Spawn")
          if not spawn then return end
          local dist = (spawn.Position - root.Position).Magnitude
          if dist > B.semiRadius or dist >= nd then return end
          local att = spawn:FindFirstChild("PromptAttachment")
          if not att then return end
          for _, child in ipairs(att:GetChildren()) do
            if child:IsA("ProximityPrompt") and child.ActionText and child.ActionText:find("Steal") then
              nearest = child; nd = dist; break
            end
          end
        end)
      end
    end
    return nearest
  end
  local function buildCallbacks(prompt)
    if B.internalCache[prompt] then return end
    local data = {holdCallbacks = {}, triggerCallbacks = {}, ready = true}
    local okHold, holds = pcall(getconnections, prompt.PromptButtonHoldBegan)
    if okHold and type(holds) == "table" then
      for _, conn in ipairs(holds) do
        if type(conn.Function) == "function" then table.insert(data.holdCallbacks, conn.Function) end
      end
    end
    local okTrigger, triggers = pcall(getconnections, prompt.Triggered)
    if okTrigger and type(triggers) == "table" then
      for _, conn in ipairs(triggers) do
        if type(conn.Function) == "function" then table.insert(data.triggerCallbacks, conn.Function) end
      end
    end
    if #data.holdCallbacks > 0 or #data.triggerCallbacks > 0 then B.internalCache[prompt] = data end
  end
  local function fireSemi(prompt)
    if not prompt or not prompt.Parent then return end
    buildCallbacks(prompt)
    local data = B.internalCache[prompt]
    if not data or not data.ready then return end
    data.ready = false
    for _, fn in ipairs(data.holdCallbacks) do pcall(fn) end
    task.wait(B.entryDelay or 0.3)
    for _, fn in ipairs(data.triggerCallbacks) do pcall(fn) end
    task.delay(0.8, function() if data then data.ready = true end end)
  end
  local function loop()
    while B.enabled do
      if selectedStealMode ~= "Semi" or selectedSemiMode ~= "V2" then break end
      local prompt = findNearestInSemi()
      if prompt then pcall(fireSemi, prompt) end
      task.wait(0.05)
    end
  end
  _G.NexusSemiV2AutoStealStart = function()
    B.semiRadius = tonumber(_G.NexusStealRadii and _G.NexusStealRadii.SemiV2SemiRadius) or 8
    B.entryDelay = tonumber(_G.NexusSemiV2EntryDelay) or 0.3
    if selectedStealMode ~= "Semi" or selectedSemiMode ~= "V2" then return end
    B.enabled = true
    if not B.conn then B.conn = task.spawn(loop) end
  end
  _G.NexusSemiV2AutoStealStop = function()
    B.enabled = false
    if B.conn then pcall(function() task.cancel(B.conn) end); B.conn = nil end
  end
  _G.NexusSemiV2AutoStealSync = function()
    if selectedStealMode == "Semi" and selectedSemiMode == "V2" and autoStealEnabled then
      _G.NexusSemiV2AutoStealStart()
    else
      _G.NexusSemiV2AutoStealStop()
    end
  end
end
