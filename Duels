local function _bypassAntiBatDefend(c, root, h)
    if not _G.NexusBypassAntiBat then return false end
    local ba = _G.NexusBypassAimbot
    local curVel = root.AssemblyLinearVelocity
    local delta = curVel - ba.prevVelocity
    local hDelta = Vector3.new(delta.X, 0, delta.Z).Magnitude
    local curHSpeed = Vector3.new(curVel.X, 0, curVel.Z).Magnitude
    local healthDrop = ba.prevHealth - h.Health
    local knockbackDetected = false

    if hDelta > _bypassKnockbackThreshold then knockbackDetected = true end
    if curHSpeed > _bypassVelocityHardCap then knockbackDetected = true end
    if healthDrop > 0 and hDelta > 20 then knockbackDetected = true end

    local st = h:GetState()
    local isRagdoll = st == Enum.HumanoidStateType.Physics
        or st == Enum.HumanoidStateType.Ragdoll
        or st == Enum.HumanoidStateType.FallingDown
    if isRagdoll then knockbackDetected = true end

    if knockbackDetected then
        root.AssemblyLinearVelocity = Vector3.new(0, math.clamp(curVel.Y, -20, 20), 0)
        root.AssemblyAngularVelocity = Vector3.zero
        pcall(function() h:ChangeState(Enum.HumanoidStateType.Running) end)
        workspace.CurrentCamera.CameraSubject = h
        pcall(function()
            local pm = LP.PlayerScripts:FindFirstChild("PlayerModule")
            if pm then require(pm:FindFirstChild("ControlModule")):Enable() end
        end)
        for _, obj in ipairs(c:GetDescendants()) do
            if obj:IsA("BallSocketConstraint")
            or (obj:IsA("Attachment") and obj.Name and obj.Name:find("Ragdoll")) then
                pcall(function() obj:Destroy() end)
            elseif obj:IsA("Motor6D") and not obj.Enabled then
                obj.Enabled = true
            end
        end
        pcall(function() c:SetAttribute("RagdollEndTime", workspace:GetServerTimeNow()) end)
    end

    for _, child in ipairs(root:GetChildren()) do
        if child:IsA("BodyVelocity") or child:IsA("BodyGyro") then
            pcall(function() child:Destroy() end)
        elseif child:IsA("Velocity") then
            pcall(function() child:Destroy() end)
        end
    end

    ba.prevVelocity = curVel
    ba.prevHealth = h.Health
    return knockbackDetected
end

