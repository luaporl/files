function _G.NexusStartBypassAimbot()
    if _G.NexusSafeModeTryStart and not _G.NexusSafeModeTryStart() then return false end
    if _G.NexusStopAutoTPForAction then _G.NexusStopAutoTPForAction() end
    if _G.NexusTpBatEnabled and _G.NexusStopTpBat then pcall(_G.NexusStopTpBat) end
    pcall(function() if _G.NexusStopNormalAimbot then _G.NexusStopNormalAimbot() end end)
    pcall(function() if _G.NexusStopNormalAimbotV2 then _G.NexusStopNormalAimbotV2() end end)
    pcall(function() if _G.NexusStopNormalAimbotV3 then _G.NexusStopNormalAimbotV3() end end)

    local ba = _G.NexusBypassAimbot
    if ba.conn then ba.conn:Disconnect(); ba.conn = nil end
    if ba.antiBatConn then ba.antiBatConn:Disconnect(); ba.antiBatConn = nil end
    _G.NexusNormalAimbotOn = true
    ba.swingCooldown = false

    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then ba.prevAutoRotate = hum.AutoRotate; hum.AutoRotate = false end
    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then ba.prevVelocity = root.AssemblyLinearVelocity end
        if hum then ba.prevHealth = hum.Health end
    end
    _bypassHookCharacter(char)
    _bypassEquip()

    ba.conn = RunService.RenderStepped:Connect(function()
        if not _G.NexusNormalAimbotOn then return end
        if selectedAimbotMode ~= "Bypass" then return end

        local c = LP.Character
        if not c then return end
        local root = c:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local h = c:FindFirstChildOfClass("Humanoid")
        if not h or h.Health <= 0 then return end

        -- light anti-bat (optional, keep defensive cancel)
        pcall(function() _bypassAntiBatDefend(c, root, h) end)

        local bat = c:FindFirstChildOfClass("Tool") or _bypassGetBat()
        if bat and bat.Parent ~= c then
