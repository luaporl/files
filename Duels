local function looksLikeImage(data)
if type(data) ~= "string" or #data < 12 then return false end
local b1, b2, b3, b4 = string.byte(data, 1, 4)
if b1 == 0xFF and b2 == 0xD8 and b3 == 0xFF then return true end
if b1 == 0x89 and b2 == 0x50 and b3 == 0x4E and b4 == 0x47 then return true end
return false
end
local function getImageAsset(url, file)
if not file then return nil end
if downloadedImageCache[file] then return downloadedImageCache[file] end
if not (writefile and getcustomasset) then return nil end
local hasFile = false
pcall(function() hasFile = isfile and isfile(file) end)
if hasFile then
local ok, asset = pcall(function() return getcustomasset(file) end)
if ok and asset then
downloadedImageCache[file] = asset
return asset
end
end
local okGet, data = pcall(function() return game:HttpGet(url) end)
if okGet and looksLikeImage(data) then
pcall(function() writefile(file, data) end)
local okAsset, asset = pcall(function() return getcustomasset(file) end)
if okAsset and asset then
downloadedImageCache[file] = asset
return asset
end
end
return nil
end
