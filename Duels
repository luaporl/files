function _G.NexusStartAutoLeft()
	local S = _G.NexusAutoPathState
	if S.leftConn then S.leftConn:Disconnect() end
	S.leftPhase = 1
	S.leftSwingTimer = 0
	S.leftConn = RunService.Heartbeat:Connect(function()
		if not autoLeftEnabled then return end
		local char = LP.Character
		if not char then return end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum or hum.Health <= 0 then return end
		if _nexusIsRagdollState(hum) then
			hum:Move(Vector3.zero, false)
			return
		end
		local P = _G.NexusAutoPathPoints
		local spd = _G.NexusAutoPathSpeed()
		if type(spd) ~= "number" or spd ~= spd then spd = 59 end
		spd = math.clamp(spd, 16, 200)

		local function toward(point)
			local flat = Vector3.new(point.X - hrp.Position.X, 0, point.Z - hrp.Position.Z)
			local dist = flat.Magnitude
			if dist < 1.5 then
				return true, nil
			end
			return false, flat.Unit
		end

		-- optional auto-swing while pathing
		if autoSwingEnabled then
			S.leftSwingTimer = (S.leftSwingTimer or 0) + 1/60
			if S.leftSwingTimer >= 0.45 then
				S.leftSwingTimer = 0
				pcall(function()
					local bat = _G.NexusFindAimbotBat and _G.NexusFindAimbotBat()
					if bat and bat.Parent == char then
						bat:Activate()
					elseif bat and bat.Parent ~= char then
						hum:EquipTool(bat)
					end
				end)
			end
		end

		if S.leftPhase == 1 then
			local done, mv = toward(P.L1)
			if done then
				S.leftPhase = 2
				local _, mv2 = toward(P.L2)
				if mv2 then _nexusDrivePathVelocity(hrp, hum, mv2, spd) end
				return
			end
			if mv then _nexusDrivePathVelocity(hrp, hum, mv, spd) end
		elseif S.leftPhase == 2 then
			local done, mv = toward(P.L2)
			if done then
				pcall(function() hum:Move(Vector3.zero, false) end)
				local v = hrp.AssemblyLinearVelocity
				hrp.AssemblyLinearVelocity = Vector3.new(0, v.Y, 0)
				if P.LFace and (P.LFace - hrp.Position).Magnitude > 0.01 then
					hrp.CFrame = CFrame.new(hrp.Position, Vector3.new(P.LFace.X, hrp.Position.Y, P.LFace.Z))
				end
				autoLeftEnabled = false
				autoLREnabled = false
				if S.leftConn then S.leftConn:Disconnect(); S.leftConn = nil end
				S.leftPhase = 1
				_nexusDestroyMoveProxy()
				if _G.NexusSetAutoLeftVisual then _G.NexusSetAutoLeftVisual(false) end
				if _G.NexusSetAutoLRVisual then _G.NexusSetAutoLRVisual(false) end
				if _G.NexusAutoLRRestoreSpeed then _G.NexusAutoLRRestoreSpeed() end
				saveNexusConfig()
				return
			end
			if mv then _nexusDrivePathVelocity(hrp, hum, mv, spd) end
		end
	end)
end

