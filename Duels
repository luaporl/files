local function nexusSlowFallDown(targetY)
	if _nexusSlowFallActive then return end
	_nexusSlowFallActive = true
	task.spawn(function()
		local POWER = 115
		local deadline = os.clock() + 6
		while os.clock() < deadline do
			local char = LP.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if not hrp or not hum or hum.Health <= 0 then break end
			if hum.FloorMaterial ~= Enum.Material.Air then break end
			hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, -POWER, hrp.AssemblyLinearVelocity.Z)
			RunService.Heartbeat:Wait()
		end
		_nexusSlowFallActive = false
		local groundDeadline = os.clock() + 8
		while os.clock() < groundDeadline do
			local c2 = LP.Character
			local h2 = c2 and c2:FindFirstChildOfClass("Humanoid")
			if not h2 or h2.Health <= 0 then break end
			if h2.FloorMaterial ~= Enum.Material.Air then break end
			RunService.Heartbeat:Wait()
		end
	end)
end

