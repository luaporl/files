		infJumpEnabled = infJumpEnabled,
		antiRagdollEnabled = antiRagdollEnabled,
	}
end
_G.NexusPerfOptRevert = function()
	local s = _G.NexusPerfOptSaved
	if not s then _G.NexusPerfOptSetStatus("Nothing to revert"); return end
	NS = s.NS; CS = s.CS; LAGGER_SPEED = s.LAGGER_SPEED; LAGGER_CARRY_SPEED = s.LAGGER_CARRY_SPEED
	autoStealRadius = s.autoStealRadius
	fpsBoostEnabled = s.fpsBoostEnabled
	if s.antiLagVisualEnabled ~= antiLagVisualEnabled then
		if s.antiLagVisualEnabled then pcall(enableAntiLag) else pcall(disableAntiLag) end
	end
	antiLagVisualEnabled = s.antiLagVisualEnabled
	if s.nukeOptimiserEnabled ~= nukeOptimiserEnabled then
		if s.nukeOptimiserEnabled then pcall(enableNukeOptimizer) else pcall(disableNukeOptimizer) end
	end
	nukeOptimiserEnabled = s.nukeOptimiserEnabled
	if s.fovEnabled ~= fovEnabled then
		if s.fovEnabled then pcall(enableCustomFov) else pcall(disableCustomFov) end
	end
	fovEnabled = s.fovEnabled; fovValue = s.fovValue
	if fovEnabled and workspace.CurrentCamera then workspace.CurrentCamera.FieldOfView = fovValue end
	nexusGuiScaleValue = s.nexusGuiScaleValue
	if nexusMainScale then nexusMainScale.Scale = nexusGuiScaleValue end
	if normalSpeedBox then normalSpeedBox.Text = tostring(NS) end
	if carrySpeedBox then carrySpeedBox.Text = tostring(CS) end
	if laggerSpeedBox then laggerSpeedBox.Text = tostring(LAGGER_SPEED) end
	if laggerCarrySpeedBox then laggerCarrySpeedBox.Text = tostring(LAGGER_CARRY_SPEED) end
	if autoStealRadiusBox then autoStealRadiusBox.Text = tostring(autoStealRadius) end
	_G.NexusPerfOptSaved = nil
	_G.NexusPerfOptSetStatus("Reverted")
	if showActionNotification then pcall(function() showActionNotification("OPTIMIZER REVERTED") end) end
	saveNexusConfig()
end
_G.NexusPerfOptRun = function()
	_G.NexusPerfOptSaveSnapshot()
	_G.NexusPerfOptSetStatus("Profiling...")
	task.wait()
	local fpsFrames, fpsStart = 0, tick()
	local fpsConn2 = RunService.RenderStepped:Connect(function() fpsFrames = fpsFrames + 1 end)
	task.wait(2.5)
	if fpsConn2 then fpsConn2:Disconnect() end
	local avgFPS = math.floor(fpsFrames / math.max(0.1, tick() - fpsStart))
	local pingMs = 0
	pcall(function()
		local stat = Stats.Network.ServerStatsItem["Data Ping"]
		if stat then pingMs = tonumber(stat:GetValue()) or 0 end
	end)
	pingMs = math.floor(pingMs)
	local memMB = 0
	pcall(function() memMB = math.floor(collectgarbage("count") / 1024) end)
	local vpX, vpY = 1920, 1080
	pcall(function()
		local cam = workspace.CurrentCamera
		if cam then vpX = cam.ViewportSize.X; vpY = cam.ViewportSize.Y end
	end)
	local applied = {}
	local function tag(name) table.insert(applied, name) end
	if avgFPS < 50 then
		if not nukeOptimiserEnabled then pcall(enableNukeOptimizer); nukeOptimiserEnabled = true; tag("Nuke Opt") end
		if not antiLagVisualEnabled then pcall(enableAntiLag); antiLagVisualEnabled = true; tag("Anti Lag") end
	elseif avgFPS < 80 then
		if not antiLagVisualEnabled then pcall(enableAntiLag); antiLagVisualEnabled = true; tag("Anti Lag") end
	elseif avgFPS > 140 then
		-- FPS is great, keep quality
	end
	if pingMs > 200 then
		LAGGER_SPEED = math.max(22, 29)
		LAGGER_CARRY_SPEED = math.max(10, 15)
		autoStealRadius = math.clamp(autoStealRadius + 3, 9, 15)
		tag("Radius +" .. tostring(3))
	elseif pingMs > 130 then
		autoStealRadius = math.clamp(autoStealRadius + 2, 9, 14)
		tag("Radius +" .. tostring(2))
	elseif pingMs < 30 then
		NS = math.min(64, 59.5)
		tag("Speed " .. tostring(NS))
	end
	if vpX < 1200 then
		nexusGuiScaleValue = math.max(0.42, nexusGuiScaleValue - 0.06)
		if nexusMainScale then nexusMainScale.Scale = nexusGuiScaleValue end
		tag("GUI Scale")
	end
	if normalSpeedBox then normalSpeedBox.Text = tostring(NS) end
	if carrySpeedBox then carrySpeedBox.Text = tostring(CS) end
	if laggerSpeedBox then laggerSpeedBox.Text = tostring(LAGGER_SPEED) end
	if laggerCarrySpeedBox then laggerCarrySpeedBox.Text = tostring(LAGGER_CARRY_SPEED) end
	if autoStealRadiusBox then autoStealRadiusBox.Text = tostring(autoStealRadius) end
	saveNexusConfig()
	local status = string.format("FPS:%d PING:%dms MEM:%dMB %s", avgFPS, pingMs, memMB, (#applied > 0 and "| " .. table.concat(applied, ", ") or "| No changes"))
	_G.NexusPerfOptSetStatus(status)
	if showActionNotification then pcall(function() showActionNotification("OPTIMIZED: " .. status) end) end
end

