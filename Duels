			local conn
			conn = RunService.Heartbeat:Connect(function(dt)
				if not clone or not clone.Parent or not vp.Parent then
					if conn then conn:Disconnect() end
					return
				end
				angle = angle + dt * 35
				pcall(function()
					clone:PivotTo(CFrame.new(0, 0.55, 0) * CFrame.Angles(0, math.rad(180 + angle), 0))
				end)
			end)
