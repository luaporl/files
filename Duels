-- Auto-detect LEFT/RIGHT from player position (nearest path start), like Ambitious AutoPlay SEMI
function _G.NexusAutoLRDetectSide()
	local P = _G.NexusAutoPathPoints
	if not P then return autoLRSide or "LEFT" end
	local char = LP.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return autoLRSide or "LEFT" end
	local pos = hrp.Position
	local function flatDist(a)
		if not a then return math.huge end
		local dx, dz = pos.X - a.X, pos.Z - a.Z
		return math.sqrt(dx * dx + dz * dz)
	end
	local dL = flatDist(P.L1)
	local dR = flatDist(P.R1)
	-- Also consider L2/R2 as fallback anchors
	local dL2 = flatDist(P.L2)
	local dR2 = flatDist(P.R2)
	dL = math.min(dL, dL2)
	dR = math.min(dR, dR2)
	if dR < dL then
		return "RIGHT"
	end
	return "LEFT"
end

