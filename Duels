function NexusGetResponsiveScale(panelWidth, panelHeight, mobileMaxScale)
	local cam = workspace.CurrentCamera
	if not cam then return 1 end
	local vs = cam.ViewportSize
	local touchDevice = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local fit = math.min((vs.X - 24) / panelWidth, (vs.Y - 48) / panelHeight, 1)
	if touchDevice then fit = math.min(fit, mobileMaxScale or 1) end
	return math.clamp(fit, 0.48, 1)
end

