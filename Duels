-- Ragdoll Steal = Synchronize After Hit (Ambitious) with +0.02s delay
-- On ragdoll rising edge: stop steal loop, wait 1.47s (2.47s medusa), restart if still enabled
_G._NexusRagdollSteal = _G._NexusRagdollSteal or {
	enabled = false,
	conn = nil,
	gen = 0,
	wasRagdoll = false,
}
_G._NexusRagdollSteal.enabled = ragdollStealEnabled == true

local function _nexusIsMedusaHit()
	return (tick() - (_G._NexusMedusaHitTime or 0)) < 4
end

local function _nexusStopStealLoops()
	pcall(function() if _G.NexusNormalAutoStealStop then _G.NexusNormalAutoStealStop() end end)
	pcall(function() if _G.NexusSemiAutoStealStop then _G.NexusSemiAutoStealStop() end end)
	pcall(function() if _G.NexusSemiV2AutoStealStop then _G.NexusSemiV2AutoStealStop() end end)
	pcall(function() if _G.StealBar then _G.StealBar.Reset() end end)
end

local function _nexusRestartStealLoops()
	if not autoStealEnabled then return end
	if not ragdollStealEnabled and not (_G._NexusRagdollSteal and _G._NexusRagdollSteal.enabled) then return end
	pcall(function()
		if _G.NexusAutoStealSync then _G.NexusAutoStealSync() end
	end)
end

local function _doNexusRagdollSteal()
	_nexusStopStealLoops()
	local myGen = _G._NexusRagdollSteal.gen
	-- Ambitious: 1.45 / 2.45  →  Nexus: +0.02 → 1.47 / 2.47
	local syncDelay = _nexusIsMedusaHit() and 2.47 or 1.47
	task.delay(syncDelay, function()
		if myGen ~= _G._NexusRagdollSteal.gen then return end
		_G._NexusRagdollSteal.wasRagdoll = false
		if (ragdollStealEnabled or _G._NexusRagdollSteal.enabled) and autoStealEnabled then
			_nexusRestartStealLoops()
		end
	end)
end

local function _startNexusRagdollStealWatcher()
	if _G._NexusRagdollSteal.conn then
		pcall(function() _G._NexusRagdollSteal.conn:Disconnect() end)
		_G._NexusRagdollSteal.conn = nil
	end
	_G._NexusRagdollSteal.wasRagdoll = false
	_G._NexusRagdollSteal.conn = RunService.Heartbeat:Connect(function()
		if not ragdollStealEnabled and not _G._NexusRagdollSteal.enabled then return end
		if not autoStealEnabled then return end
		local char = LP.Character
		if not char then return end
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health <= 0 then return end
		local state = hum:GetState()
		-- Physics + Ragdoll only (same as Ambitious; FallingDown excluded)
		local isRagdolled = (state == Enum.HumanoidStateType.Physics
			or state == Enum.HumanoidStateType.Ragdoll)
		if isRagdolled and not _G._NexusRagdollSteal.wasRagdoll then
			_G._NexusRagdollSteal.wasRagdoll = true
			_G._NexusRagdollSteal.gen = (_G._NexusRagdollSteal.gen or 0) + 1
			_doNexusRagdollSteal()
		elseif not isRagdolled then
			_G._NexusRagdollSteal.wasRagdoll = false
		end
	end)
end

