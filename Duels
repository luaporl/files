		local hrp = char:FindFirstChild("HumanoidRootPart")
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum or hum.Health <= 0 then return end
		local oldVelocity = hrp.AssemblyLinearVelocity
		hrp.AssemblyLinearVelocity = Vector3.new(999, 0, 999)
		RunService.RenderStepped:Wait()
		if hrp and hrp.Parent then
			hrp.AssemblyLinearVelocity = oldVelocity
		end
		if antibatSpaceHeld then
			antibatJumpTimer = antibatJumpTimer + deltaTime
			if antibatJumpTimer >= ANTIBAT_JUMP_INTERVAL then
				antibatJumpTimer = 0
