local function _nexusJsonSafe(v, depth)
	depth = depth or 0
	if depth > 12 then return nil end
	local t = typeof(v)
	if t == "nil" or t == "boolean" or t == "string" then return v end
	if t == "number" then
		if v ~= v or v == math.huge or v == -math.huge then return 0 end
		return v
	end
	if t == "Color3" then
		return {
			math.floor(v.R * 255 + 0.5),
			math.floor(v.G * 255 + 0.5),
			math.floor(v.B * 255 + 0.5),
		}
	end
	if t == "EnumItem" then
		return tostring(v):gsub("^Enum%.[^%.]+%.", "")
	end
	if t == "Vector3" then
		return {v.X, v.Y, v.Z}
	end
	if t == "table" then
		local out = {}
		local isArray = true
		local maxn = 0
		for k in pairs(v) do
			if type(k) ~= "number" or k < 1 or k ~= math.floor(k) then
				isArray = false
				break
			end
			if k > maxn then maxn = k end
		end
		if isArray and maxn > 0 then
			for i = 1, maxn do
				out[i] = _nexusJsonSafe(v[i], depth + 1)
			end
		else
			for k, val in pairs(v) do
				if type(k) == "string" or type(k) == "number" then
					local sk = type(k) == "number" and tostring(k) or k
					out[sk] = _nexusJsonSafe(val, depth + 1)
				end
			end
		end
		return out
	end
	-- functions, Instances, userdata, threads -> drop
	return nil
end

