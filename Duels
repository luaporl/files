		local function clearPreviewViewport(vp)
			for _, child in ipairs(vp:GetChildren()) do
				if not child:IsA("Camera") and not child:IsA("UIAspectRatioConstraint") then
					child:Destroy()
				end
			end
		end

		local function makePreview(vp, packName)
			clearPreviewViewport(vp)

			-- ViewportFrames use their own 3D lighting. PointLights do not reliably light
			-- ViewportFrames, so use the built-in Ambient/LightDirection system.
			vp.Ambient = Color3.fromRGB(190, 190, 190)
			vp.LightColor = Color3.fromRGB(255, 255, 255)
			vp.LightDirection = Vector3.new(-1, -1, -1)

			local cam = Instance.new("Camera")
			cam.Name = "Camera"
			cam.FieldOfView = 32
			cam.Parent = vp
			vp.CurrentCamera = cam

			local world = Instance.new("WorldModel")
			world.Name = "World"
			world.Parent = vp

			local source = LP.Character
			local model
			if source then
				local oldArchivable
				local ok, cloned = pcall(function()
					oldArchivable = source.Archivable
					source.Archivable = true
					local c = source:Clone()
					source.Archivable = oldArchivable
					return c
				end)
				if ok and cloned then model = cloned end
				pcall(function() if oldArchivable ~= nil then source.Archivable = oldArchivable end end)
			end

			if not model then
				-- Fallback for characters that cannot be cloned directly.
				pcall(function()
					local Players = game:GetService("Players")
					if Players.CreateHumanoidModelFromUserId then
						model = Players:CreateHumanoidModelFromUserId(LP.UserId)
					end
				end)
			end
			if not model then return end

			model.Name = "NexusSkinPreview"
			for _, desc in ipairs(model:GetDescendants()) do
				if desc:IsA("Script") or desc:IsA("LocalScript") or desc:IsA("ModuleScript") or desc:IsA("Tool") then
