local dropBrainrotActive = false
local DROP_ASCEND_DURATION = 0.15
local DROP_ASCEND_SPEED = 150
local function runDropBrainrot()
	if dropBrainrotActive then return end
	if _G.NexusStopAutoTPForAction then _G.NexusStopAutoTPForAction() end
	local char = LP.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end
	dropBrainrotActive = true
	local wasAntibatOn = antibatEnabled == true
	if wasAntibatOn then
		antibatEnabled = false
		if _G._nexusAntibatStop then _G._nexusAntibatStop() end
		if setAntibatVisual then setAntibatVisual(false) end
	end
	local startTime = tick()
	local dropConn
	dropConn = RunService.Heartbeat:Connect(function()
		local currentChar = LP.Character
		local currentRoot = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
		if not currentChar or not currentRoot then
			if dropConn then dropConn:Disconnect() end
			dropBrainrotActive = false
			return
		end
		if tick() - startTime >= DROP_ASCEND_DURATION then
			if dropConn then dropConn:Disconnect() end
			-- Always NORMAL TP for drop (ignore SLOW method), then leave method as-is for later TP downs
			doAutoTPDown(true, true)
			dropBrainrotActive = false
			if wasAntibatOn then
				antibatEnabled = true
				antibatSpaceHeld = true
				if _G._nexusAntibatStart then _G._nexusAntibatStart() end
				if setAntibatVisual then setAntibatVisual(true) end
				saveNexusConfig()
			end
			return
		end
		local v = currentRoot.AssemblyLinearVelocity
		currentRoot.AssemblyLinearVelocity = Vector3.new(v.X, DROP_ASCEND_SPEED, v.Z)
		currentRoot.Velocity = Vector3.new(v.X, DROP_ASCEND_SPEED, v.Z)
	end)
	task.delay(1.0, function()
		if dropBrainrotActive then
			dropBrainrotActive = false
			if dropConn then pcall(function() dropConn:Disconnect() end) end
		end
	end)
end
local function doDrop()
runDropBrainrot()
end
