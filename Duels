}

local V3_STICKY_TIME = 1.25
local V3_STICKY_MAX_DIST = 85

function _G.NexusStartNormalAimbotV3()
if _G.NexusSafeModeTryStart and not _G.NexusSafeModeTryStart() then return false end
if _G.NexusStopAutoTPForAction then _G.NexusStopAutoTPForAction() end
autoLeftEnabled = false
autoRightEnabled = false
if _G.NexusSetAutoLeftVisual then _G.NexusSetAutoLeftVisual(false) end
if _G.NexusSetAutoRightVisual then _G.NexusSetAutoRightVisual(false) end
if _G.NexusStopAutoLeft then _G.NexusStopAutoLeft() end
if _G.NexusStopAutoRight then _G.NexusStopAutoRight() end
if _G.NexusNormalAimbot.conn then _G.NexusStopNormalAimbot() end
if _G.NexusNormalAimbotV2 and _G.NexusNormalAimbotV2.conn then _G.NexusStopNormalAimbotV2() end

_G.NexusNormalAimbotOn = true
local state = _G.NexusNormalAimbotV3
if state.conn then state.conn:Disconnect(); state.conn=nil end
state.target=nil
state.stickyTarget=nil
state.stickyUntil=0
state.lastScan=0

state.conn = RunService.Heartbeat:Connect(function()
if not _G.NexusNormalAimbotOn or selectedAimbotMode ~= "Normal" or aimbotVersion ~= "V3" then return end
local char=LP.Character
if not char then return end
local root=char:FindFirstChild("HumanoidRootPart")
if not root then return end
local hum=char:FindFirstChildOfClass("Humanoid")
if not hum or hum.Health<=0 then return end

if not char:FindFirstChildOfClass("Tool") then
local bat=_G.NexusFindAimbotBat and _G.NexusFindAimbotBat() or nil
if bat then pcall(function() hum:EquipTool(bat) end) end
end

local now=tick()
local target=state.stickyTarget
local function valid(t)
if not t or not t.Parent then return false end
local th=t.Parent:FindFirstChildOfClass("Humanoid")
if not th or th.Health<=0 then return false end
return (t.Position-root.Position).Magnitude <= V3_STICKY_MAX_DIST
end

if not valid(target) or now >= state.stickyUntil then
if now-state.lastScan > 0.12 then
state.lastScan=now
target=_G.NexusGetClosestAimbotTarget()
state.stickyTarget=target
state.stickyUntil=now+V3_STICKY_TIME
end
else
target=state.stickyTarget
end

if not target then
state.target=nil
hum.AutoRotate=true
root.AssemblyAngularVelocity=Vector3.zero
return
end

state.target=target
hum.AutoRotate=false
local targetVel=target.AssemblyLinearVelocity or Vector3.zero
local myPos=root.Position
local targetPos=target.Position
local predictPos=targetPos+targetVel*0.14+target.CFrame.LookVector*0.3
local direction=predictPos-myPos
local flatDir=Vector3.new(direction.X,0,direction.Z)
if flatDir.Magnitude>0.01 then flatDir=flatDir.Unit else flatDir=Vector3.new(0,0,1) end

local chaseSpeed=tonumber(AIMBOT_SPEED) or 58
local desiredHeight=targetPos.Y+3.7
local yVel=(desiredHeight-myPos.Y)*19.5+targetVel.Y*0.8
if hum.FloorMaterial~=Enum.Material.Air then yVel=math.max(yVel,13) end
yVel=math.clamp(yVel,-70,110)
local desiredVel=Vector3.new(flatDir.X*chaseSpeed,yVel,flatDir.Z*chaseSpeed)
root.AssemblyLinearVelocity=root.AssemblyLinearVelocity:Lerp(desiredVel,0.8)

local speed3=targetVel.Magnitude
local predictTime=math.clamp(speed3/150,0.05,0.2)
local predictedPos=targetPos+targetVel*predictTime
local toPredict=predictedPos-myPos
if toPredict.Magnitude>0.1 then
local goalCF=CFrame.lookAt(myPos,predictedPos)
local diffCF=root.CFrame:Inverse()*goalCF
local rx,ry,rz=diffCF:ToEulerAnglesXYZ()
rx=math.clamp(rx,-2.5,2.5)
ry=math.clamp(ry,-2.5,2.5)
rz=math.clamp(rz,-2.5,2.5)
root.AssemblyAngularVelocity=root.CFrame:VectorToWorldSpace(Vector3.new(rx*42,ry*42,rz*42))
end

if autoSwingEnabled~=false then
local bat=char:FindFirstChild("Bat") or (_G.NexusFindAimbotBat and _G.NexusFindAimbotBat())
if bat and bat:IsA("Tool") then pcall(function() bat:Activate() end) end
end
end)
if _G.NexusRefreshAimbotVisual then _G.NexusRefreshAimbotVisual() end
return true
end

function _G.NexusStopNormalAimbotV3()
_G.NexusNormalAimbotOn=false
local state=_G.NexusNormalAimbotV3
if state and state.conn then state.conn:Disconnect();state.conn=nil end
if state then state.target=nil;state.stickyTarget=nil;state.stickyUntil=0;state.lastScan=0 end
local c=LP.Character
local root=c and c:FindFirstChild("HumanoidRootPart")
if root then root.AssemblyLinearVelocity=Vector3.zero;root.AssemblyAngularVelocity=Vector3.zero end
local hum=c and c:FindFirstChildOfClass("Humanoid")
if hum then hum.AutoRotate=true end
if _G.NexusRefreshAimbotVisual then _G.NexusRefreshAimbotVisual() end
end
end

do -- Bypass Aimbot + Anti-Bat Defense (combined offensive chase + defensive knockback cancel)
_G.NexusBypassAimbot = {conn = nil, antiBatConn = nil, swingCooldown = false, prevAutoRotate = nil, prevVelocity = Vector3.zero, prevHealth = 100}
_G.NexusBypassAimbotSpeed = _G.NexusBypassAimbotSpeed or 58
_G.NexusBypassAimbotLaggerSpeed = _G.NexusBypassAimbotLaggerSpeed or 40
_G.NexusBypassAimbotHitDist = _G.NexusBypassAimbotHitDist or 5
_G.NexusBypassUseHiddenProp = _G.NexusBypassUseHiddenProp or false
_G.NexusBypassAntiBat = _G.NexusBypassAntiBat or true
_G.NexusBypassAntiBatVelocitySpike = _G.NexusBypassAntiBatVelocitySpike or false

local _bypassCharConn = nil
local _bypassKnockbackThreshold = 40
local _bypassVelocityHardCap = 120

local function _bypassGetSpeed()
    return _G.NexusBypassAimbotSpeed or 58
end

local function _bypassGetClosest()
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil, math.huge end
    local closest, minDist = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local tRoot = plr.Character:FindFirstChild("HumanoidRootPart")
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if tRoot and hum and hum.Health > 0 then
                local dist = (tRoot.Position - root.Position).Magnitude
                if dist < minDist then minDist = dist; closest = tRoot end
            end
        end
    end
    return closest, minDist
end

local function _bypassGetBat()
    local char = LP.Character
    if not char then return nil end
    local batNames = {"Bat", "Slap", "Iron Slap", "Gold Slap", "Diamond Slap", "Emerald Slap", "Ruby Slap", "Dark Matter Slap", "Flame Slap", "Nuclear Slap", "Galaxy Slap", "Glitched Slap"}
    for _, name in ipairs(batNames) do
        local t = char:FindFirstChild(name)
        if t and t:IsA("Tool") then return t end
    end
    for _, ch in ipairs(char:GetChildren()) do
        if ch:IsA("Tool") and (ch.Name:lower():find("bat") or ch.Name:lower():find("slap")) then return ch end
    end
    local bp = LP:FindFirstChildOfClass("Backpack") or LP:FindFirstChild("Backpack")
    if bp then
        for _, name in ipairs(batNames) do
            local t = bp:FindFirstChild(name)
            if t and t:IsA("Tool") then return t end
        end
        for _, ch in ipairs(bp:GetChildren()) do
            if ch:IsA("Tool") and (ch.Name:lower():find("bat") or ch.Name:lower():find("slap")) then return ch end
        end
    end
    return nil
end

local function _bypassTryHitBat()
    if _G.NexusBypassAimbot.swingCooldown then return end
    _G.NexusBypassAimbot.swingCooldown = true
    pcall(function()
        local bat = _bypassGetBat()
        if bat then
            bat:Activate()
            local ev = bat:FindFirstChildWhichIsA("RemoteEvent")
            if ev then ev:FireServer() end
        end
    end)
    task.delay(0.08, function() _G.NexusBypassAimbot.swingCooldown = false end)
end

local function _bypassEquip()
    pcall(function()
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not char or not hum or hum.Health <= 0 then return end
        if char:FindFirstChildOfClass("Tool") then return end
        local bat = _bypassGetBat()
        if bat and bat.Parent ~= char then
            pcall(function() hum:EquipTool(bat) end)
        end
    end)
end

local function _bypassHookCharacter(char)
    if _bypassCharConn then _bypassCharConn:Disconnect(); _bypassCharConn = nil end
    if not char then return end
    _bypassCharConn = char.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then
            task.defer(function()
                if _G.NexusNormalAimbotOn and child.Parent == char
                and not (child.Name:lower():find("bat") or child.Name:lower():find("slap")) then
                    _bypassEquip()
                end
            end)
        end
    end)
end

local function _bypassAntiBatDefend(c, root, h)
    if not _G.NexusBypassAntiBat then return false end
    local ba = _G.NexusBypassAimbot
    local curVel = root.AssemblyLinearVelocity
    local delta = curVel - ba.prevVelocity
    local hDelta = Vector3.new(delta.X, 0, delta.Z).Magnitude
    local curHSpeed = Vector3.new(curVel.X, 0, curVel.Z).Magnitude
    local healthDrop = ba.prevHealth - h.Health
    local knockbackDetected = false

    if hDelta > _bypassKnockbackThreshold then knockbackDetected = true end
    if curHSpeed > _bypassVelocityHardCap then knockbackDetected = true end
    if healthDrop > 0 and hDelta > 20 then knockbackDetected = true end

    local st = h:GetState()
    local isRagdoll = st == Enum.HumanoidStateType.Physics
        or st == Enum.HumanoidStateType.Ragdoll
        or st == Enum.HumanoidStateType.FallingDown
    if isRagdoll then knockbackDetected = true end

    if knockbackDetected then
        root.AssemblyLinearVelocity = Vector3.new(0, math.clamp(curVel.Y, -20, 20), 0)
        root.AssemblyAngularVelocity = Vector3.zero
        pcall(function() h:ChangeState(Enum.HumanoidStateType.Running) end)
        workspace.CurrentCamera.CameraSubject = h
        pcall(function()
            local pm = LP.PlayerScripts:FindFirstChild("PlayerModule")
            if pm then require(pm:FindFirstChild("ControlModule")):Enable() end
        end)
        for _, obj in ipairs(c:GetDescendants()) do
            if obj:IsA("BallSocketConstraint")
            or (obj:IsA("Attachment") and obj.Name and obj.Name:find("Ragdoll")) then
                pcall(function() obj:Destroy() end)
            elseif obj:IsA("Motor6D") and not obj.Enabled then
                obj.Enabled = true
            end
        end
        pcall(function() c:SetAttribute("RagdollEndTime", workspace:GetServerTimeNow()) end)
    end

    for _, child in ipairs(root:GetChildren()) do
        if child:IsA("BodyVelocity") or child:IsA("BodyGyro") then
            pcall(function() child:Destroy() end)
        elseif child:IsA("Velocity") then
            pcall(function() child:Destroy() end)
        end
    end

    ba.prevVelocity = curVel
    ba.prevHealth = h.Health
    return knockbackDetected
end

function _G.NexusStartBypassAimbot()
    if _G.NexusSafeModeTryStart and not _G.NexusSafeModeTryStart() then return false end
    if _G.NexusStopAutoTPForAction then _G.NexusStopAutoTPForAction() end
    local ba = _G.NexusBypassAimbot
    if ba.conn then ba.conn:Disconnect(); ba.conn = nil end
    if ba.antiBatConn then ba.antiBatConn:Disconnect(); ba.antiBatConn = nil end
    _G.NexusNormalAimbotOn = true
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then ba.prevAutoRotate = hum.AutoRotate; hum.AutoRotate = false; hum.JumpPower = 0 end
    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then ba.prevVelocity = root.AssemblyLinearVelocity end
        if hum then ba.prevHealth = hum.Health end
    end
    _bypassHookCharacter(char)
    _bypassEquip()

    ba.conn = RunService.RenderStepped:Connect(function()
        if not _G.NexusNormalAimbotOn then return end

        local c = LP.Character
        if not c then return end
        local root = c:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local h = c:FindFirstChildOfClass("Humanoid")
        if not h or h.Health <= 0 then return end

        _bypassAntiBatDefend(c, root, h)

        if _G.NexusBypassAntiBatVelocitySpike then
            local origXZ = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z)
            root.AssemblyLinearVelocity = Vector3.new(4000, root.AssemblyLinearVelocity.Y, 4000)
            task.defer(function()
                if root and root.Parent then
                    root.AssemblyLinearVelocity = Vector3.new(origXZ.X, root.AssemblyLinearVelocity.Y, origXZ.Z)
                end
            end)
        end

        h.JumpPower = 0

        if autoSwingEnabled then
            local swingTool = c:FindFirstChildOfClass("Tool")
            if swingTool and (swingTool.Name:lower():find("bat") or swingTool.Name:lower():find("slap")) then
                pcall(function() swingTool:Activate() end)
            end
        end

        local target, targetDist = _bypassGetClosest()
        if not target then
            h.AutoRotate = true
            root.AssemblyAngularVelocity = Vector3.zero
            return
        end
        h.AutoRotate = false

        local spd = laggerActive and _G.NexusBypassAimbotLaggerSpeed or _bypassGetSpeed()

        if _G.NexusBypassUseHiddenProp then
            if sethiddenproperty then
                pcall(function() sethiddenproperty(root, "PhysicsRepRootPart", target) end)
            end
        end

        local forwardPredict = target.Position + target.CFrame.LookVector * 1.5
        local dir = (forwardPredict - root.Position).Unit
        root.Velocity = Vector3.new(dir.X * spd, dir.Y * spd, dir.Z * spd)

        local lookTarget = CFrame.lookAt(root.Position, target.Position)
        root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, math.atan2(-lookTarget.LookVector.X, -lookTarget.LookVector.Z), 0)

        if targetDist <= _G.NexusBypassAimbotHitDist then
            _bypassTryHitBat()
        end
    end)
    if _G.NexusRefreshAimbotVisual then _G.NexusRefreshAimbotVisual() end
end

function _G.NexusStopBypassAimbot()
    _G.NexusNormalAimbotOn = false
    local ba = _G.NexusBypassAimbot
    if ba.conn then ba.conn:Disconnect(); ba.conn = nil end
    if ba.antiBatConn then ba.antiBatConn:Disconnect(); ba.antiBatConn = nil end
    if _bypassCharConn then _bypassCharConn:Disconnect(); _bypassCharConn = nil end
    ba.swingCooldown = false
    local c = LP.Character
    local root = c and c:FindFirstChild("HumanoidRootPart")
    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
    local hum = c and c:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.AutoRotate = (ba.prevAutoRotate == nil) and true or ba.prevAutoRotate
        hum.JumpPower = 60
        hum.PlatformStand = false
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    end
    ba.prevAutoRotate = nil
    if _G.NexusRefreshAimbotVisual then _G.NexusRefreshAimbotVisual() end
end

