			g.TextXAlignment = Enum.TextXAlignment.Center
			g.TextYAlignment = Enum.TextYAlignment.Center
			g.ZIndex = (arrow.ZIndex or 1) + 1
			g.Parent = arrow
			return g
		end
		up = mk("GlyphUp", "▲")
		down = mk("GlyphDown", "▼")
		down.TextTransparency = 1
		down.TextStrokeTransparency = 1
		arrow.Text = ""
	end
