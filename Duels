			vp.CurrentCamera = cam

			local world = Instance.new("WorldModel")
			world.Name = "World"
			world.Parent = vp

			-- Use the prototype built at execute time (assets preloaded, idle pose)
			-- so the preview is complete and identical to the Skin Changer source.
			local proto = previewPrototypes[packName]
			if not proto then
				proto = buildPreviewPrototype(packName)
