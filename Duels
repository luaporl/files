		end)
	end
	if config.headTransparency ~= nil and head then
		pcall(function() head.Transparency = tonumber(config.headTransparency) or 0 end)
	end

	local accList = {}
	if type(config.accessories) == "table" then
		for _, id in ipairs(config.accessories) do table.insert(accList, id) end
	elseif config.accessory then
		table.insert(accList, config.accessory)
	end
	for _, child in ipairs(char:GetChildren()) do
		if child.Name == "NexusPackAcc" or (type(child.Name) == "string" and child.Name:sub(1, 13) == "NexusPackAcc_") then
			pcall(function() child:Destroy() end)
		end
	end
	local function _nexusFindAtt(model, name)
		for _, p in ipairs(model:GetDescendants()) do
			if p:IsA("Attachment") and p.Name == name and p.Parent and p.Parent:IsA("BasePart") then
				return p
			end
		end
		return nil
	end
	for _, accId in ipairs(accList) do
		local objs = nil
		local ok, res = pcall(function() return game:GetObjects("rbxassetid://" .. tostring(accId)) end)
		if ok and typeof(res) == "table" and #res > 0 then objs = res
		else
			ok, res = pcall(function() return game:GetService("InsertService"):LoadAsset(accId) end)
			if ok and res then objs = {res} end
		end
		if objs then
			local handle
			for _, o in ipairs(objs) do
				if o:IsA("BasePart") and o.Name == "Handle" then handle = o; break end
			end
			if not handle then
				for _, o in ipairs(objs) do
					if o:IsA("BasePart") then handle = o; break end
					local f = o:FindFirstChildWhichIsA("BasePart", true)
					if f then handle = f; break end
				end
			end
			if handle then
				local h = handle:Clone()
				h.Name = (#accList > 1) and ("NexusPackAcc_" .. tostring(accId)) or "NexusPackAcc"
				h.CanCollide = false
				h.Anchored = false
				h.Massless = true
				local hAtt = h:FindFirstChildOfClass("Attachment")
				local bAtt = hAtt and _nexusFindAtt(char, hAtt.Name)
				local target = (bAtt and bAtt.Parent)
					or char:FindFirstChild("UpperTorso")
					or char:FindFirstChild("Torso")
					or head
				if target then
					local c0 = bAtt and bAtt.CFrame or CFrame.new(config.offset or Vector3.new(0, 0.3, 0))
					local c1 = hAtt and hAtt.CFrame or CFrame.new()
					h.CFrame = target.CFrame * c0 * c1:Inverse()
					h.Parent = char
					local weld = Instance.new("Weld")
					weld.Part0 = target
					weld.Part1 = h
					weld.C0 = c0
					weld.C1 = c1
					weld.Parent = h
				else
					pcall(function() h:Destroy() end)
				end
			end
			for _, o in ipairs(objs) do pcall(function() o:Destroy() end) end
		end
	end

	if config.korblox and config.korblox ~= "none" then
		pcall(function()
			local ids = {left = 139607673, right = 139607718}
			local targets = {left = "LeftUpperLeg", right = "RightUpperLeg"}
			local hides = {left = {"LeftUpperLeg","LeftLowerLeg","LeftFoot"}, right = {"RightUpperLeg","RightLowerLeg","RightFoot"}}
			local side = config.korblox
			local targetPart = char:FindFirstChild(targets[side])
			if not targetPart then return end
			for _, pn in ipairs(hides[side]) do
				local limb = char:FindFirstChild(pn)
				if limb and limb:IsA("BasePart") then limb.Transparency = 1 end
			end
			local ok2, objects = pcall(function() return game:GetObjects("rbxassetid://" .. ids[side]) end)
			if not ok2 or not objects or #objects == 0 then return end
			local assetModel = objects[1]
			local mainMesh = assetModel:IsA("BasePart") and assetModel or assetModel:FindFirstChildWhichIsA("BasePart", true)
			if not mainMesh then assetModel:Destroy(); return end
			mainMesh.CanCollide = false; mainMesh.Massless = true
			mainMesh.CFrame = targetPart.CFrame
			local wc = Instance.new("WeldConstraint")
			wc.Part0 = targetPart; wc.Part1 = mainMesh; wc.Parent = mainMesh
			assetModel.Parent = char
		end)
	end
	return true
end

