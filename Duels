local function looksLikeImage(data)
if type(data) ~= "string" or #data < 12 then return false end
local b1, b2, b3, b4 = string.byte(data, 1, 4)
if b1 == 0xFF and b2 == 0xD8 and b3 == 0xFF then return true end
