    end)

    _G.NexusTpBatConn = RunService.Heartbeat:Connect(function(dt)
        if not _G.NexusTpBatEnabled then return end

        if not _G.NexusTpBatHrp or not _G.NexusTpBatHrp.Parent then
            if LP.Character then setupChar(LP.Character) end
            if not _G.NexusTpBatHrp then return end
        end

        local target, dist = _nexusTpBatGetClosestPlayer()
        if target and target.Character then
            local tRoot = target.Character:FindFirstChild("HumanoidRootPart")
            if tRoot then

                if tpBatVersion == "V1" then
                    -- V1 = standalone TP Bat recipe (NO PhysicsRep):
                    -- stand 2.5 studs from target facing them + pin every Heartbeat
                    -- + 0.8s settle after far gap / target change + autoswing every 0.4s
                    local STAND_DIST, STAND_HEIGHT, SETTLE_TIME, SWING_INTERVAL, FAR_GAP = 2.5, 0.9, 0.8, 0.4, 8
                    local hrp = _G.NexusTpBatHrp
                    if target ~= _G._NexusTpBatV1LastTarget then
                        _G._NexusTpBatV1LastTarget = target
                        _G._NexusTpBatV1SettleUntil = os.clock() + SETTLE_TIME
                    end
                    if not LP.Character:FindFirstChildOfClass("Tool") then
                        _nexusTpBatGetBat()
                    end
                    local dir = (hrp.Position - tRoot.Position)
                    if dir.Magnitude < 1 then dir = -tRoot.CFrame.LookVector end
                    dir = Vector3.new(dir.X, 0, dir.Z)
                    if dir.Magnitude < 0.05 then dir = Vector3.new(0, 0, 1) end
                    dir = dir.Unit
                    local standPos = tRoot.Position + dir * STAND_DIST + Vector3.new(0, STAND_HEIGHT, 0)
                    local gap = (hrp.Position - standPos).Magnitude
                    if gap > FAR_GAP then
                        _G._NexusTpBatV1SettleUntil = os.clock() + SETTLE_TIME
                    end
                    hrp.CFrame = CFrame.lookAt(
                        standPos,
                        Vector3.new(tRoot.Position.X, standPos.Y, tRoot.Position.Z)
                    )
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                    local cam = workspace.CurrentCamera
                    if cam then
                        cam.CFrame = CFrame.new(cam.CFrame.Position, tRoot.Position + Vector3.new(0, 1, 0))
                    end
                    -- autoswing after settle (respects Auto Swing toggle)
                    if autoSwingEnabled ~= false then
                        local settleUntil = _G._NexusTpBatV1SettleUntil or 0
                        local lastSwing = _G._NexusTpBatV1LastSwing or 0
                        local now = os.clock()
                        if now >= settleUntil and (now - lastSwing) >= SWING_INTERVAL then
                            _G._NexusTpBatV1LastSwing = now
                            pcall(function()
                                local bat = _nexusTpBatGetBat()
                                if bat then bat:Activate() end
                            end)
                        end
                    end
                elseif tpBatVersion == "V3" then
                    -- V3 = TP BAT v15 recipe (NO PhysicsRep): stand 2.5 + pin + settle +
                    -- velocity lead + ragdoll-verify 180 flip + autoswing same-frame
                    local STAND_DIST, STAND_HEIGHT = 2.5, 0.9
                    local SETTLE_TIME, SWING_COOLDOWN, VERIFY_WINDOW = 0.8, 0.4, 0.7
                    local LEAD_BASE, LEAD_FAST, LEAD_AIR = 0.02, 0.08, 0.06
                    local VEL_SMOOTH, Y_VEL_SMOOTH = 20, 28
                    local hrp = _G.NexusTpBatHrp
                    local hum = _G.NexusTpBatH
                    local tChar = target.Character
                    local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
                    if not (hrp and tHum and tHum.Health > 0) then return end
                    if hum then hum.AutoRotate = false end
                    local now = os.clock()
                    dt = (typeof(dt) == "number" and dt > 0) and dt or 0.016

                    -- state bag
                    local S = _G._NexusTpBatV3
                    if type(S) ~= "table" then
                        S = {
                            currentTarget = nil, angleOffset = 0, pendingVerify = nil,
                            lastSwingAt = 0, settleUntil = now + SETTLE_TIME,
                            smoothVel = Vector3.zero, smoothYVel = 0,
                        }
                        _G._NexusTpBatV3 = S
                    end

                    if target ~= S.currentTarget then
                        S.currentTarget = target
                        S.angleOffset = 0
                        S.pendingVerify = nil
                        S.smoothVel = Vector3.zero
                        S.smoothYVel = 0
                        S.settleUntil = now + SETTLE_TIME
                    end

                    if not LP.Character:FindFirstChildOfClass("Tool") then
                        _nexusTpBatGetBat()
                    end

                    local rawVel = tRoot.AssemblyLinearVelocity
                    local flatVel = Vector3.new(rawVel.X, 0, rawVel.Z)
                    local aH = 1 - math.exp(-VEL_SMOOTH * dt)
                    S.smoothVel = S.smoothVel:Lerp(flatVel, aH)
                    local aY = 1 - math.exp(-Y_VEL_SMOOTH * dt)
                    S.smoothYVel = S.smoothYVel + (rawVel.Y - S.smoothYVel) * aY
                    local speed = S.smoothVel.Magnitude
                    local t = math.clamp(speed / 25, 0, 1)
                    local lead = LEAD_BASE + (LEAD_FAST - LEAD_BASE) * t
                    local state = tHum:GetState()
                    if state == Enum.HumanoidStateType.Freefall
                        or state == Enum.HumanoidStateType.Jumping
                        or state == Enum.HumanoidStateType.FallingDown then
                        lead = LEAD_AIR
                    end
                    local predPos = tRoot.Position
                        + S.smoothVel * lead
                        + Vector3.new(0, S.smoothYVel * lead, 0)

                    local dir = hrp.Position - tRoot.Position
                    if dir.Magnitude < 1 then dir = -tRoot.CFrame.LookVector end
                    dir = Vector3.new(dir.X, 0, dir.Z)
                    if dir.Magnitude < 0.05 then dir = Vector3.new(0, 0, 1) end
                    dir = dir.Unit
                    if S.angleOffset ~= 0 then
                        local c, s = math.cos(S.angleOffset), math.sin(S.angleOffset)
                        local dx, dz = dir.X, dir.Z
                        dir = Vector3.new(dx * c - dz * s, 0, dx * s + dz * c)
                        S.angleOffset = 0
                    end

                    local standPos = Vector3.new(
                        predPos.X + dir.X * STAND_DIST,
                        predPos.Y + STAND_HEIGHT,
                        predPos.Z + dir.Z * STAND_DIST
                    )
                    hrp.CFrame = CFrame.lookAt(
                        standPos,
                        Vector3.new(predPos.X, standPos.Y, predPos.Z)
                    )
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero

                    local cam = workspace.CurrentCamera
                    if cam then
                        cam.CFrame = CFrame.new(cam.CFrame.Position, tRoot.Position + Vector3.new(0, 1, 0))
                    end

                    -- verify previous swing via RagdollEndTime (flip on confirmed miss)
                    local pv = S.pendingVerify
                    if pv then
                        if pv.tgt ~= target or pv.tChar ~= tChar then
                            S.pendingVerify = nil
                        else
                            local rag = target:GetAttribute("RagdollEndTime") or 0
                            local srvNow = workspace:GetServerTimeNow()
                            local ragAct = rag > srvNow
                            local hp = tHum.Health
                            if ragAct then pv.everRag = true end
                            if rag > pv.beforeRag or hp < pv.beforeHp then
                                S.pendingVerify = nil
                            elseif (now - pv.swingAt) >= VERIFY_WINDOW then
                                if not pv.everRag and not ragAct then
                                    S.angleOffset = math.pi
                                end
                                S.pendingVerify = nil
                            end
                        end
                    end

                    -- Autoswing: same helper as V1/V2 (+ fire all remotes like linked v15)
                    if autoSwingEnabled ~= false and now >= (S.settleUntil or 0) then
                        if (now - (S.lastSwingAt or 0)) >= 0.08 then
                            S.lastSwingAt = now
                            pcall(function()
                                local bat = _nexusTpBatGetBat()
                                if not bat then return end
                                bat:Activate()
                                for _, ch in ipairs(bat:GetDescendants()) do
                                    if ch:IsA("RemoteEvent") then
                                        pcall(function() ch:FireServer() end)
                                    elseif ch:IsA("RemoteFunction") then
                                        pcall(function() ch:InvokeServer() end)
                                    end
                                end
                            end)
                            if not S.pendingVerify then
                                S.pendingVerify = {
                                    swingAt = now,
                                    beforeRag = target:GetAttribute("RagdollEndTime") or 0,
                                    beforeHp = tHum.Health,
                                    everRag = false,
                                    tgt = target,
                                    tChar = tChar,
                                }
                            end
                        end
                    end
                else
                    pcall(function()
                        if sethiddenproperty then
                            sethiddenproperty(_G.NexusTpBatHrp, "PhysicsRepRootPart", tRoot)
                            pcall(function() sethiddenproperty(_G.NexusTpBatHrp, "NetworkOwnership", 9999) end)
                        end
                    end)

                    if _G.NexusTpBatMode == "Orbit" then
                        local currentTime = tick()
                        local speed = _G.NexusTpBatOrbitSpeed
                        local radius = _G.NexusTpBatOrbitRadius
                        local offsetX = math.sin(currentTime * speed) * radius
                        local offsetZ = math.cos(currentTime * speed) * radius
                        _G.NexusTpBatHrp.CFrame = CFrame.new(
                            tRoot.Position + Vector3.new(offsetX, 0, offsetZ),
                            tRoot.Position
                        )
                    elseif _G.NexusTpBatMode == "Behind" then
                        local behind = tRoot.CFrame * CFrame.new(0, 0, 3)
                        _G.NexusTpBatHrp.CFrame = CFrame.new(behind.Position, tRoot.Position)
                        _G.NexusTpBatHrp.AssemblyLinearVelocity = Vector3.zero
                        _G.NexusTpBatHrp.AssemblyAngularVelocity = Vector3.zero
                    else
                        local targetPos = tRoot.Position + Vector3.new(0, 0.9, 0)
                        if (_G.NexusTpBatHrp.Position - targetPos).Magnitude > 8 then
                            _G.NexusTpBatHrp.CFrame = CFrame.new(targetPos)
                        end
                    end

                    if not _G.NexusTpBatSilentAim then
                        local cam = workspace.CurrentCamera
                        if cam then cam.CFrame = CFrame.new(cam.CFrame.Position, tRoot.Position) end
                    end

                    _nexusTpBatTryHit()
                end

            end
        end
    end)

    _G.NexusAutoTPRestoreWanted = false
    if not _G.NexusAntiDieOn then
        _G.NexusTpBatAutoAntiDie = true
        if _G.NexusStartAntiDie then pcall(_G.NexusStartAntiDie) end
    end

    if _G.NexusSetTpBatVisual then _G.NexusSetTpBatVisual(true) end
    saveNexusConfig()
