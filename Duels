					break
				end
			end
			if not sourceHandle then return end

			local h = sourceHandle:Clone()
			h.Name = name
			h.Anchored = true
			h.CanCollide = false
			h.Massless = true
			h.CFrame = head.CFrame * CFrame.new(offset or Vector3.new(0, head.Size.Y * 0.5 + 0.3, 0))
