local function setActive(btn, state)
	if not btn then return end
	local pressed = btn:GetAttribute("NexusMobilePressed") == true
	state = (state == true) or pressed
	local visualState = state and "on" or "off"
	if btn:GetAttribute("NexusMobileVisualState") == visualState then return end
	btn:SetAttribute("NexusMobileVisualState", visualState)
	TS:Create(btn, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		BackgroundColor3 = state and Color3.fromRGB(235, 235, 235) or Color3.fromRGB(12, 12, 14),
	}):Play()
	local top = btn:FindFirstChild("Top")
	local bot = btn:FindFirstChild("Bot")
	if top then
		TS:Create(top, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			TextColor3 = state and Color3.fromRGB(15, 15, 16) or Color3.fromRGB(245, 245, 245),
		}):Play()
	end
	if bot then
		TS:Create(bot, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			TextColor3 = state and Color3.fromRGB(15, 15, 16) or Color3.fromRGB(180, 180, 190),
		}):Play()
	end
end
