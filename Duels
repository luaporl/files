do
  local autoOffPlayerConns = {}
  local autoOffCharConns = {}

  local function onEnemyRagdollStarted()
    -- Aimbot off
    if autoOffAimbotEnabled or _G.NexusAutoOffAimbot then
      if _G.NexusNormalAimbotOn then
        pcall(function() if _G.NexusStopNormalAimbot then _G.NexusStopNormalAimbot() end end)
        pcall(function() if _G.NexusStopNormalAimbotV2 then _G.NexusStopNormalAimbotV2() end end)
