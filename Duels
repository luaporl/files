end
local dropBrainrotActive = false
local DROP_ASCEND_DURATION = 0.2
local DROP_ASCEND_SPEED = 150
local function runDropBrainrot()
	if dropBrainrotActive then return end
	local char = LP.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end
	dropBrainrotActive = true
	local wasAntibatOn = antibatEnabled == true
	if wasAntibatOn then
		antibatEnabled = false
		if _G._nexusAntibatStop then _G._nexusAntibatStop() end
		if setAntibatVisual then setAntibatVisual(false) end
		task.wait(0.1)
	end
	if _G.NexusClearLinVel then _G.NexusClearLinVel() end
	root.AssemblyLinearVelocity = Vector3.new(0, DROP_ASCEND_SPEED, 0)
	root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
	task.delay(DROP_ASCEND_DURATION, function()
		if not char or not char.Parent or not root or not root.Parent then
			dropBrainrotActive = false
			return
		end
		if _G.NexusClearLinVel then _G.NexusClearLinVel() end
		root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
		local rp = RaycastParams.new()
		rp.FilterDescendantsInstances = {char}
		rp.FilterType = Enum.RaycastFilterType.Exclude
		rp.RespectCanCollide = true
		local rr = workspace:Raycast(root.Position, Vector3.new(0, -500, 0), rp)
		local hum2 = char:FindFirstChildOfClass("Humanoid")
		local off = (hum2 and hum2.HipHeight or 2) + (root.Size.Y / 2)
		if rr then
			root.CFrame = CFrame.new(rr.Position + Vector3.new(0, off, 0)) * CFrame.Angles(0, select(2, root.CFrame:ToEulerAnglesYXZ()), 0)
		else
			root.CFrame = CFrame.new(root.Position.X, off, root.Position.Z)
		end
		root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
		if _G.NexusClearLinVel then _G.NexusClearLinVel() end
		dropBrainrotActive = false
		if wasAntibatOn then
			antibatEnabled = true
			antibatSpaceHeld = true
			if _G._nexusAntibatStart then _G._nexusAntibatStart() end
			if setAntibatVisual then setAntibatVisual(true) end
			saveNexusConfig()
		end
	end)
end
local function doDrop()
runDropBrainrot()
end
