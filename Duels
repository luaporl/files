local speedImpulseHRP = nil

local function massImpulse(hrp, dir, spd)
	local mass = hrp.AssemblyMass or 1
	local current = hrp.AssemblyLinearVelocity
	local desired = Vector3.new(dir.X * spd, current.Y, dir.Z * spd)
	local delta = desired - current
	pcall(function() hrp:ApplyImpulse(Vector3.new(delta.X, 0, delta.Z) * mass) end)
end

local function ensureSpeedHRP(hrp)
	speedImpulseHRP = hrp
end

local function clearSpeedImpulse()
	speedImpulseHRP = nil
end

local function setSpeedXZ(x, z)
	local hrp = speedImpulseHRP
	if not hrp or not hrp.Parent then return end
	local mass = hrp.AssemblyMass or 1
	local current = hrp.AssemblyLinearVelocity
	local delta = Vector3.new(x - current.X, 0, z - current.Z)
	pcall(function() hrp:ApplyImpulse(delta * mass) end)
end

