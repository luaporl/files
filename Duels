		local isPlaying = sound.IsPlaying == true or sound.Playing == true
		if isPlaying then
			playing = true
			local tl = sound.TimeLength
			local tp = sound.TimePosition
			if tl and tl > 0 and tl == tl then
				progressFill.Size = UDim2.new(math.clamp(tp / tl, 0, 1), 0, 1, 0)
				timeLabel.Text = fmtTime(tp) .. " / " .. fmtTime(tl)
			end
		elseif not switching then
			-- paused or stopped: keep showing last position instead of snapping to 0
			local tl = sound.TimeLength
			local tp = sound.TimePosition
			if tp and tp > 0 and tl and tl > 0 and tl == tl then
