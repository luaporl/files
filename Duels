        pcall(function() if _G.NexusRefreshAimbotVisual then _G.NexusRefreshAimbotVisual() end end)
        pcall(function() if showActionNotification then showActionNotification("AIMBOT OFF (RAGDOLL)") end end)
      end
    end
    -- TP Bat off
    if autoOffTpBatEnabled or _G.NexusAutoOffTpBat then
      if _G.NexusTpBatEnabled then
        pcall(function() if _G.NexusStopTpBat then _G.NexusStopTpBat() end end)
        pcall(function() if showActionNotification then showActionNotification("TP BAT OFF (RAGDOLL)") end end)
      end
    end
  end

  local function setupEnemyDetector(char)
    if not char then return end
    local key = tostring(char)
    if autoOffCharConns[key] then
      pcall(function() autoOffCharConns[key]:Disconnect() end)
    end
    autoOffCharConns[key] = char.DescendantAdded:Connect(function(d)
      if d:IsA("BallSocketConstraint") then
        onEnemyRagdollStarted()
      end
    end)
    char.AncestryChanged:Connect(function(_, parent)
      if not parent and autoOffCharConns[key] then
        pcall(function() autoOffCharConns[key]:Disconnect() end)
        autoOffCharConns[key] = nil
      end
    end)
  end

  local function watchPlayer(plr)
    if plr == LP then return end
    if autoOffPlayerConns[plr] then
      pcall(function() autoOffPlayerConns[plr]:Disconnect() end)
    end
    autoOffPlayerConns[plr] = plr.CharacterAdded:Connect(function(char)
      setupEnemyDetector(char)
    end)
    if plr.Character then setupEnemyDetector(plr.Character) end
  end

  for _, plr in ipairs(Players:GetPlayers()) do watchPlayer(plr) end
  Players.PlayerAdded:Connect(watchPlayer)
  Players.PlayerRemoving:Connect(function(plr)
    if autoOffPlayerConns[plr] then
      pcall(function() autoOffPlayerConns[plr]:Disconnect() end)
      autoOffPlayerConns[plr] = nil
    end
  end)
end

