			end
			if not proto then return end

			local clone = proto:Clone()
			clone.Name = "NexusSkinPreview"
			clone.Parent = world

			-- Exact Skin Changer transform: pivot at origin, camera framing identical to source
			pcall(function()
				clone:PivotTo(CFrame.new(0, 0.55, 0) * CFrame.Angles(0, math.rad(180), 0))
			end)
			cam.CFrame = CFrame.lookAt(Vector3.new(0, 3.35, 8.2), Vector3.new(0, 2.35, 0))

