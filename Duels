local function nexusNukeUnderPlots(obj)
if not obj then return false end
local p = obj
while p and p ~= game do
if p.Name == "Plots" or p.Name == "AnimalPodiums" or p.Name == "PlotSign" then return true end
local nl = tostring(p.Name):lower()
if nl:find("plot", 1, true) or (nl:find("base", 1, true) and p:IsA("Model")) then
local q = p.Parent
while q and q ~= game do
if q.Name == "Plots" then return true end
q = q.Parent
end
end
p = p.Parent
end
return false
end
local function nexusNukeIsCharPart(obj)
if not obj then return false end
local p = obj
while p and p ~= game do
if p:IsA("Model") and (p:FindFirstChildOfClass("Humanoid") or p:FindFirstChild("HumanoidRootPart")) then return true end
p = p.Parent
end
return false
end
local function nexusNukeSafeDestroy(obj)
if not obj or obj.Name == "Overhead" then return end
if nexusNukeUnderPlots(obj) then return end
if nexusNukeIsCharPart(obj) then return end
if obj:IsA("Beam") or obj:IsA("Laser") then return end
pcall(function() obj:Destroy() end)
end
local function nexusNukeIsClothing(obj)
if nexusNukeIsCharPart(obj) then return false end
for _, c in ipairs(_nexusNukeClothing) do if obj:IsA(c) then return true end end
return false
end
local function nexusNukeIsBase(obj)
if nexusNukeUnderPlots(obj) then return false end
if not obj:IsA("BasePart") then return false end
local nl = obj.Name:lower()
for _, n in ipairs(_nexusNukeBaseNames) do
if nl:find(n, 1, true) then return true end
end
return false
end
local function nexusNukeIsInBase(obj)
if nexusNukeUnderPlots(obj) then return true end
local p = obj.Parent
while p and p ~= workspace do
if nexusNukeIsBase(p) then return true end
p = p.Parent
end
return false
end
local function nexusNukeOutOfRange(obj)
if nexusNukeUnderPlots(obj) then return false end
if obj:IsA("BasePart") then
local x = obj.Position.X
return x < _nexusNukeXMin or x > _nexusNukeXMax
end
return false
end
local function nexusNukeMakeTransparent(obj)
if nexusNukeUnderPlots(obj) then return end
pcall(function()
if nexusNukeIsBase(obj) and not nexusNukeIsCharPart(obj) then
obj.Transparency = 1
obj.CastShadow = false
end
end)
end
local function nexusNukeCleanObject(obj)
pcall(function()
if obj:IsA("SurfaceAppearance") then
nexusNukeSafeDestroy(obj)
elseif obj:IsA("Decal") or obj:IsA("Texture") then
if not (obj.Name == "face" and obj.Parent and obj.Parent.Name == "Head") then
nexusNukeSafeDestroy(obj)
end
elseif obj:IsA("SpecialMesh") then
nexusNukeSafeDestroy(obj)
end
end)
end
local function nexusNukeStripObject(obj)
pcall(function()
if obj:IsA("Texture") or obj:IsA("Decal") or obj:IsA("SpecialMesh") then
nexusNukeSafeDestroy(obj)
elseif obj:IsA("Beam") then
return
elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
pcall(function() obj.Enabled = false end)
nexusNukeSafeDestroy(obj)
elseif obj:IsA("SurfaceAppearance") then
nexusNukeSafeDestroy(obj)
elseif obj:IsA("BasePart") then
obj.CastShadow = false
obj.Material = Enum.Material.Plastic
pcall(function() obj.MaterialVariant = "" end)
obj.Reflectance = 0
end
end)
end
local function nexusNukeApplyObject(obj)
pcall(function()
if nexusNukeUnderPlots(obj) then return end
if nexusNukeIsCharPart(obj) then return end
if nexusNukeIsBase(obj) then nexusNukeMakeTransparent(obj); return end
if nexusNukeIsClothing(obj) then nexusNukeSafeDestroy(obj); return end
if nexusNukeIsInBase(obj) then return end
if nexusNukeOutOfRange(obj) then nexusNukeSafeDestroy(obj); return end
nexusNukeCleanObject(obj)
nexusNukeStripObject(obj)
end)
end
