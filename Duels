		flatX, flatZ = flatX/mag, flatZ/mag
	end
	linVelInstance.PlaneVelocity = Vector2.new(flatX * spd, flatZ * spd)
	else
	clearLinVel()
	end
	else
	clearLinVel()
	end
	else
	clearLinVel()
	end
