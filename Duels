	-- Rainbow Bat + Medusa (exact KyzDuels Bat and Meduse Rainbow logic)
	do
		local _batMedusaRain = {
			enabled = false,
			originals = {},
			conn = nil,
			hue = 0,
			SPEED = 0.45,
		}

		local function _bmPlayerFolder()
			local plr = LP
			if not plr then return nil end
			return workspace:FindFirstChild(plr.Name)
		end

		local function _bmGetTools()
			local bat, med = nil, nil
			local folder = _bmPlayerFolder()
			if folder then
				bat = folder:FindFirstChild("Bat")
				med = folder:FindFirstChild("Medusa's Head")
			end
			local char = LP and LP.Character
			if not bat and char then
				bat = char:FindFirstChild("Bat")
				if not bat then
					for _, t in ipairs(char:GetChildren()) do
						if t:IsA("Tool") and t.Name:lower():find("bat", 1, true) then bat = t; break end
					end
				end
			end
			if not med and char then
				med = char:FindFirstChild("Medusa's Head")
				if not med then
					for _, t in ipairs(char:GetChildren()) do
						if t:IsA("Tool") and t.Name:lower():find("medusa", 1, true) then med = t; break end
					end
				end
			end
			local bp = LP and (LP:FindFirstChildOfClass("Backpack") or LP:FindFirstChild("Backpack"))
			if not bat and bp then
				bat = bp:FindFirstChild("Bat")
				if not bat then
					for _, t in ipairs(bp:GetChildren()) do
						if t:IsA("Tool") and t.Name:lower():find("bat", 1, true) then bat = t; break end
					end
				end
			end
			if not med and bp then
				med = bp:FindFirstChild("Medusa's Head")
				if not med then
					for _, t in ipairs(bp:GetChildren()) do
						if t:IsA("Tool") and t.Name:lower():find("medusa", 1, true) then med = t; break end
					end
				end
			end
			return bat, med
		end

		local function _bmForEachPart(model, fn)
			if not model then return end
			if model:IsA("BasePart") then fn(model) end
			for _, d in ipairs(model:GetDescendants()) do
				if d:IsA("BasePart") then
					fn(d)
				elseif d:IsA("Decal") or d:IsA("Texture") then
					fn(d)
				end
			end
		end

		local function _bmEnsureRainbowHighlight(model)
			if not model then return nil end
			local h = model:FindFirstChild("_NexusRainbowHL")
			if not h then
				h = Instance.new("Highlight")
				h.Name = "_NexusRainbowHL"
				h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				h.FillTransparency = 0.4
				h.OutlineTransparency = 0.15
				h.Parent = model
			end
			return h
		end

		local function _bmPaintRainbow(model, color)
			if not model then return end
			local hl = _bmEnsureRainbowHighlight(model)
			if hl then
				pcall(function()
					hl.FillColor = color
					hl.OutlineColor = color
				end)
			end
			_bmForEachPart(model, function(d)
				if d:IsA("BasePart") then
					if _batMedusaRain.originals[d] == nil then
						pcall(function()
							_batMedusaRain.originals[d] = {
								Color = d.Color,
								TextureID = (d:IsA("MeshPart") and d.TextureID) or nil,
							}
						end)
					end
					pcall(function()
						if d:IsA("MeshPart") and d.TextureID ~= "" then
							d.TextureID = ""
						end
						d.Color = color
					end)
				end
			end)
		end

		local function enableBatMedusaRainbow()
			_batMedusaRain.enabled = true
			_batMedusaRain.hue = 0
			if _batMedusaRain.conn then pcall(function() _batMedusaRain.conn:Disconnect() end) end

			_batMedusaRain.conn = RunService.Heartbeat:Connect(function(dt)
				if not _batMedusaRain.enabled then return end
				_batMedusaRain.hue = (_batMedusaRain.hue + (dt or 0.016) * _batMedusaRain.SPEED) % 1
				local color = Color3.fromHSV(_batMedusaRain.hue, 1, 1)
				local bat, med = _bmGetTools()
				if bat then _bmPaintRainbow(bat, color) end
				if med then _bmPaintRainbow(med, color) end
			end)
		end

		local function disableBatMedusaRainbow()
			_batMedusaRain.enabled = false
			if _batMedusaRain.conn then pcall(function() _batMedusaRain.conn:Disconnect() end) _batMedusaRain.conn = nil end

			local bat, med = _bmGetTools()
			for _, model in ipairs({ bat, med }) do
				if model then
					local h = model:FindFirstChild("_NexusRainbowHL")
					if h then pcall(function() h:Destroy() end) end
				end
			end

			for inst, old in pairs(_batMedusaRain.originals) do
				pcall(function()
					if inst and inst.Parent and type(old) == "table" then
						if old.Color then inst.Color = old.Color end
						if old.TextureID ~= nil and inst:IsA("MeshPart") then
							inst.TextureID = old.TextureID
						end
					elseif inst and inst.Parent and typeof(old) == "Color3" then
						inst.Color = old
					end
				end)
			end
			table.clear(_batMedusaRain.originals)
		end

		_G.NexusRainbowBatSetEnabled = function(on)
			on = on and true or false
			rainbowBatEnabled = on
			if on then
				enableBatMedusaRainbow()
			else
				disableBatMedusaRainbow()
			end
			saveNexusConfig()
		end

		-- restore on load
		task.defer(function()
			if rainbowBatEnabled then
				pcall(function() _G.NexusRainbowBatSetEnabled(true) end)
			end
		end)
		LP.CharacterAdded:Connect(function()
			task.delay(0.5, function()
				if rainbowBatEnabled and _batMedusaRain.enabled then
					-- force re-bind tools after respawn
					pcall(enableBatMedusaRainbow)
				end
			end)
		end)
	end

	-- Custom Sounds
	do
		local enabled = false
		local tracked = setmetatable({}, { __mode = "k" })
		local hooked = setmetatable({}, { __mode = "k" })

		local function playCustom(entry)
			local cs = entry.sound
			if not cs or not cs.Parent then return end
			local d = entry.data
			if entry.timer then pcall(task.cancel, entry.timer); entry.timer = nil end
			pcall(function()
				cs:Stop()
				cs.TimePosition = d.skip or 0
				cs.Volume = 1
				cs:Play()
			end)
			if d.doublePlay and d.delay then
				entry.timer = task.delay(d.delay, function()
					entry.timer = nil
					if not enabled then return end
					if cs and cs.Parent then
						pcall(function()
							cs:Stop()
							cs.TimePosition = d.skip or 0
							cs:Play()
						end)
					end
				end)
			end
		end

		local function hookSound(entry, snd)
			if not snd:IsA("Sound") then return end
			if snd.Name == "NexusCustomSound" then return end
			if hooked[snd] then return end
			hooked[snd] = true
			entry.muted = entry.muted or {}
			entry.muted[snd] = snd.Volume
			local function trigger()
				if not enabled then return end
				if snd.Playing or snd.TimePosition > 0 then
					pcall(function() snd.Volume = 0; snd:Stop() end)
					playCustom(entry)
				end
			end
			table.insert(entry.conns, snd:GetPropertyChangedSignal("Playing"):Connect(trigger))
			table.insert(entry.conns, snd:GetPropertyChangedSignal("TimePosition"):Connect(trigger))
			if snd.Playing then trigger() end
		end

		local function setupTool(tool)
			if tracked[tool] then return end
			local key = isBatTool(tool) and "Bat" or (isMedusaTool(tool) and "Medusa" or nil)
			if not key then return end
			local data = SOUNDS[key]
			if not data then return end
			local handle = tool:FindFirstChild("Handle")
			if not handle then
				local c
				c = tool.ChildAdded:Connect(function(ch)
					if ch.Name == "Handle" and enabled then
						pcall(function() c:Disconnect() end)
						setupTool(tool)
					end
				end)
				return
			end
			local old = handle:FindFirstChild("NexusCustomSound")
			if old then pcall(function() old:Destroy() end) end
			local cs = Instance.new("Sound")
			cs.Name = "NexusCustomSound"
			cs.SoundId = data.id
			cs.Volume = 1
			cs.Looped = false
			cs.RollOffMode = Enum.RollOffMode.Inverse
			cs.MaxDistance = 1000
			cs.Parent = handle
			local entry = { sound = cs, data = data, conns = {}, muted = {} }
			tracked[tool] = entry
			for _, d in ipairs(tool:GetDescendants()) do hookSound(entry, d) end
			table.insert(entry.conns, tool.DescendantAdded:Connect(function(d)
				if tracked[tool] then hookSound(entry, d) end
			end))
			table.insert(entry.conns, tool.AncestryChanged:Connect(function(_, parent)
				if not parent then
					local e = tracked[tool]
					if e then
						for _, c in ipairs(e.conns) do pcall(function() c:Disconnect() end) end
						if e.sound then pcall(function() e.sound:Destroy() end) end
						for snd, vol in pairs(e.muted or {}) do
							hooked[snd] = nil
							if snd and snd.Parent then pcall(function() snd.Volume = vol end) end
						end
						tracked[tool] = nil
					end
				end
			end))
		end

		local function teardownAll()
			for tool, entry in pairs(tracked) do
				for _, c in ipairs(entry.conns) do pcall(function() c:Disconnect() end) end
				if entry.sound then pcall(function() entry.sound:Destroy() end) end
				for snd, vol in pairs(entry.muted or {}) do
					hooked[snd] = nil
					if snd and snd.Parent then pcall(function() snd.Volume = vol end) end
				end
				tracked[tool] = nil
			end
		end

		local function scan()
			if not enabled then return end
			local bp = LP:FindFirstChildOfClass("Backpack")
			if bp then for _, t in ipairs(bp:GetChildren()) do if t:IsA("Tool") then setupTool(t) end end end
			local char = LP.Character
			if char then for _, t in ipairs(char:GetChildren()) do if t:IsA("Tool") then setupTool(t) end end end
		end

		_G.NexusCustomSoundsSetEnabled = function(on)
			enabled = on and true or false
			customSoundsEnabled = enabled
			if enabled then scan() else teardownAll() end
			saveNexusConfig()
		end
		-- If config already loaded with custom sounds ON, apply now
		if customSoundsEnabled then
			enabled = true
			task.defer(function() pcall(scan) end)
		end

		task.spawn(function()
			while true do
				task.wait(0.6)
				if enabled then pcall(scan) end
			end
		end)
		LP.CharacterAdded:Connect(function()
			task.delay(0.6, function() if enabled then pcall(scan) end end)
		end)
	end
end
end)()

