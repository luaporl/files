-- ============================================================
-- TP BAT (Bypass Aimbot) — from Cursed Hub
-- Teleports behind closest enemy and swings bat.
-- Modes: Regular (orbit), OP, V3, OP V4
-- ============================================================
local _tpBatHittingCooldown = false
local _tpBatHittingCooldownTime = 0.08

_G.NexusTpBatMode = _G.NexusTpBatMode or "Orbit"
_G.NexusTpBatSilentAim = _G.NexusTpBatSilentAim or false
_G.NexusTpBatOrbitSpeed = _G.NexusTpBatOrbitSpeed or 25
_G.NexusTpBatOrbitRadius = _G.NexusTpBatOrbitRadius or 2.5

local XLU0_TP_BAT_NAMES = {
    "Bat","Slap","Iron Slap","Gold Slap","Diamond Slap",
    "Emerald Slap","Ruby Slap","Dark Matter Slap","Flame Slap",
    "Nuclear Slap","Galaxy Slap","Glitched Slap"
}

local function _nexusTpBatGetBat()
    local char = LP.Character
    if not char then return nil end
    for _, name in ipairs(XLU0_TP_BAT_NAMES) do
        local tool = char:FindFirstChild(name)
        if tool and tool:IsA("Tool") then return tool end
    end
    for _, ch in ipairs(char:GetChildren()) do
        if ch:IsA("Tool") and ch.Name:lower():find("bat") then return ch end
    end
    local bp = LP:FindFirstChild("Backpack")
    if bp then
        for _, name in ipairs(XLU0_TP_BAT_NAMES) do
            local tool = bp:FindFirstChild(name)
            if tool and tool:IsA("Tool") then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then pcall(function() hum:EquipTool(tool) end) end
                return tool
            end
        end
        for _, ch in ipairs(bp:GetChildren()) do
            if ch:IsA("Tool") and ch.Name:lower():find("bat") then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then pcall(function() hum:EquipTool(ch) end) end
                return ch
            end
        end
    end
    return nil
end

local function _nexusTpBatTryHit()
    if _tpBatHittingCooldown then return end
    _tpBatHittingCooldown = true
    pcall(function()
        local bat = _nexusTpBatGetBat()
        if bat then
            bat:Activate()
            local ev = bat:FindFirstChildWhichIsA("RemoteEvent")
            if ev then ev:FireServer() end
        end
    end)
    task.delay(_tpBatHittingCooldownTime, function() _tpBatHittingCooldown = false end)
end

local function _nexusTpBatGetClosestPlayer()
    if not _G.NexusTpBatHrp then return nil, math.huge end
    local closest, closestDist = nil, math.huge
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local tRoot = p.Character:FindFirstChild("HumanoidRootPart")
            local tHum = p.Character:FindFirstChildOfClass("Humanoid")
            if tRoot and tHum and tHum.Health > 0 then
                local dist = (_G.NexusTpBatHrp.Position - tRoot.Position).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closest = p
                end
            end
        end
    end
    return closest, closestDist
end

function _G.NexusStartTpBat()
    if _G.NexusTpBatConn then return end
    if _G.NexusSafeModeTryStart and not _G.NexusSafeModeTryStart() then return false end
    if _G.NexusStopAutoTPForAction then _G.NexusStopAutoTPForAction() end
    if _G.NexusStopNormalAimbot then _G.NexusStopNormalAimbot() end
    if _G.NexusStopNormalAimbotV2 then _G.NexusStopNormalAimbotV2() end
    _G.NexusTpBatEnabled = true
    _G.NexusTpBatRemoteCache = nil

    local function setupChar(char)
        if not char then return end
        _G.NexusTpBatH = char:FindFirstChildOfClass("Humanoid")
        _G.NexusTpBatHrp = char:FindFirstChild("HumanoidRootPart")
    end
