end
local function _nexusEnsureMoveProxy()
	local c = LP.Character
	if not c then return nil end
	local root = c:FindFirstChild("HumanoidRootPart")
	if not root then return nil end
	if _nexusMoveProxy and _nexusMoveProxy.Parent == c then return _nexusMoveProxy end
	if _nexusMoveProxy then pcall(function() _nexusMoveProxy:Destroy() end) end
	_nexusMoveProxy = Instance.new("Part")
	_nexusMoveProxy.Name = "Nexus_MoveProxy"
	_nexusMoveProxy.Size = Vector3.new(1, 1, 1)
	_nexusMoveProxy.Transparency = 1
	_nexusMoveProxy.CanCollide = false
	_nexusMoveProxy.Massless = true
	_nexusMoveProxy.Anchored = false
	_nexusMoveProxy.Parent = c
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = _nexusMoveProxy
	weld.Parent = _nexusMoveProxy
	return _nexusMoveProxy
end

