				if not (handle and handle:IsA("BasePart")) then
					handle = tool:FindFirstChildWhichIsA("BasePart", true)
				end
				playSwingSound(handle or tool)
			end)
		end

		local function applyToTool()
			if not resolveTemplate() then return false end
			local tool = getMedusaTool()
			if not tool then return false end
			local handle = tool:FindFirstChild("Handle")
			if not (handle and handle:IsA("BasePart")) then
				handle = tool:FindFirstChildWhichIsA("BasePart", true)
			end
			if not handle then return false end

			local existing = tool:FindFirstChild("_NexusMedusaCustomVisual")
			if existing then
				hideOriginal(handle)
				pcall(function() hookSwing(tool) end)
				return true
			end

			hideOriginal(handle)
			local vis = state.template:Clone()
			vis.Name = "_NexusMedusaCustomVisual"
			pcall(function() vis:SetAttribute("_NexusCustomId", state.resolvedId) end)
			vis.Parent = tool

			local weldPart = nil
			if vis:IsA("BasePart") then
				weldPart = vis
				vis.Anchored = false
				vis.CanCollide = false
				vis.Massless = true
				vis.Transparency = 0
			elseif vis:IsA("Model") then
				weldPart = vis.PrimaryPart or vis:FindFirstChildWhichIsA("BasePart", true)
				for _, d in ipairs(vis:GetDescendants()) do
					if d:IsA("BasePart") then
						d.Anchored = false
						d.CanCollide = false
						d.CanQuery = false
						d.CanTouch = false
						d.Massless = true
						d.Transparency = 0
					end
				end
			end
			if not weldPart then
				pcall(function() vis:Destroy() end)
				return false
			end

			local weld = Instance.new("Weld")
			weld.Name = "_NexusMedusaCustomWeld"
			weld.Part0 = handle
			weld.Part1 = weldPart
			weld.C0 = OMINOUS.grip
			weld.C1 = CFrame.new()
			weld.Parent = vis

			state.visuals[tool] = vis
			pcall(function() hookSwing(tool) end)
			return true
		end

		local function clearTool(tool)
			if not tool then return end
			local vis = tool:FindFirstChild("_NexusMedusaCustomVisual")
			if vis then pcall(function() vis:Destroy() end) end
			if state.visuals[tool] then
				pcall(function()
					if state.visuals[tool].Parent then state.visuals[tool]:Destroy() end
				end)
				state.visuals[tool] = nil
			end
		end

		local function restoreAll()
			for inst, old in pairs(state.originals) do
				pcall(function()
					if inst and inst.Parent and type(old) == "table" then
						if old.Transparency ~= nil and (inst:IsA("BasePart") or inst:IsA("Decal") or inst:IsA("Texture")) then
							inst.Transparency = old.Transparency
						end
						if old.Color and inst:IsA("BasePart") then inst.Color = old.Color end
						if old.Scale and inst:IsA("SpecialMesh") then inst.Scale = old.Scale end
					end
				end)
			end
			table.clear(state.originals)
			for snd, old in pairs(state.mutedSounds) do
				if snd and snd.Parent and type(old) == "table" then
					pcall(function() snd.Volume = old.Volume or 1 end)
				end
			end
			table.clear(state.mutedSounds)
			local tool = getMedusaTool()
			if tool then clearTool(tool) end
			for t in pairs(state.visuals) do clearTool(t) end
			table.clear(state.visuals)
		end

