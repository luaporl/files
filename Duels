		-- force full reapply (clear cache so applyAvatarFX3 does not early-return)
		pcall(function()
			if _G.clearAvatarFX3 then _G.clearAvatarFX3(char)
			elseif clearAvatarFX3 then clearAvatarFX3(char) end
		end)
		task.defer(function()
			local c = LP.Character
			if not c then return end
			pcall(function()
				if _G.applyAvatarFX3 then _G.applyAvatarFX3(c)
				elseif applyAvatarFX3 then applyAvatarFX3(c) end
			end)
		end)
		saveNexusConfig()
		return
	end
	-- non-FX3 pack: disable FX3 first
	fx3Enabled = false
	pcall(function()
		if _G.clearAvatarFX3 then _G.clearAvatarFX3(char)
		elseif clearAvatarFX3 then clearAvatarFX3(char) end
	end)
	if not _G.NexusOriginalOutfit.shirt and not _G.NexusOriginalOutfit.pants then
		nexusSaveOriginalOutfit(char)
	end
	if #_G.NexusOriginalAccessories == 0 then
		nexusSaveOriginalAccessories(char)
	end
	nexusClearAllOutfit(char)
	nexusClearAllAccessories(char)
	applyBleedOutfit(packName)
	-- re-apply custom shirt/pants if user has them set
