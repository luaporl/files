and type(checkcaller) == "function"
and type(newcclosure) == "function"
and type(setreadonly) == "function"
end
local function _antiDropIsLocalHrp(inst, key)
if key ~= "AssemblyLinearVelocity" and key ~= "Velocity" then return false end
if typeof(inst) ~= "Instance" or not inst:IsA("BasePart") then return false end
if inst.Name ~= "HumanoidRootPart" then return false end
local char = LP.Character
